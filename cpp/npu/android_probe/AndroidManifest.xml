<?xml version="1.0" encoding="utf-8"?>
<!-- Test-only APK: runs the Pixel TPU client inside an ordinary untrusted app
     process (via `am instrument`), separate from the Starling app. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="dev.starling.npuprobe">
    <uses-sdk android:minSdkVersion="31" android:targetSdkVersion="36" />
    <application android:label="Starling NPU probe" android:extractNativeLibs="true" android:hasCode="true">
        <uses-native-library android:name="libedgetpu_litert.so" android:required="false" />
    </application>
    <instrumentation
        android:name=".ProbeInstrumentation"
        android:targetPackage="dev.starling.npuprobe" />
</manifest>
