# embed_spv.cmake — writes the SPIR-V table used by vk::find_shader.
# Invoked as: cmake -DENTRIES="name@path@nbind|..." -DOUT=file.cpp -P embed_spv.cmake
string(REPLACE "|" ";" _entries "${ENTRIES}")
set(_body "// Generated by cpp/fast/embed_spv.cmake. Do not edit.\n#include \"vk_runtime.hpp\"\n#include <cstring>\nnamespace starling::fast::vk {\nnamespace {\n")
set(_table "")
foreach(_e IN LISTS _entries)
  string(REPLACE "@" ";" _p "${_e}")
  list(GET _p 0 _name)
  list(GET _p 1 _path)
  list(GET _p 2 _nb)
  file(READ "${_path}" _hex HEX)
  string(LENGTH "${_hex}" _hl)
  math(EXPR _tail "${_hl} % 8")
  if(NOT _tail EQUAL 0)
    message(FATAL_ERROR "${_path}: SPIR-V size is not a multiple of 4 bytes")
  endif()
  math(EXPR _nwords "${_hl} / 8")
  # little-endian bytes -> uint32 words
  string(REGEX REPLACE "(..)(..)(..)(..)" "0x\\4\\3\\2\\1u," _words "${_hex}")
  string(APPEND _body "const uint32_t k_${_name}[] = {${_words}};\n")
  string(APPEND _table "    {\"${_name}\", k_${_name}, ${_nwords}, ${_nb}},\n")
endforeach()
string(APPEND _body "const ShaderBlob k_table[] = {\n${_table}};\n} // namespace\n")
string(APPEND _body "const ShaderBlob* find_shader(const char* name) {\n    for (const ShaderBlob& b : k_table)\n        if (std::strcmp(b.name, name) == 0) return &b;\n    return nullptr;\n}\n} // namespace starling::fast::vk\n")
file(WRITE "${OUT}.tmp" "${_body}")
configure_file("${OUT}.tmp" "${OUT}" COPYONLY)
