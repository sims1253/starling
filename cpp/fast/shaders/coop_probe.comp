#version 450
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require
layout(local_size_x = 128, local_size_y = 1, local_size_z = 1) in;
layout(std430, binding = 0) readonly buffer ABuf { float16_t a[]; };
layout(std430, binding = 1) readonly buffer BBuf { float16_t b[]; };
layout(std430, binding = 2) buffer CBuf { float c[]; };
void main() {
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> ca;
    coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> cb;
    coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> acc =
        coopmat<float, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator>(0.0f);
    coopMatLoad(ca, a, uint(0), uint(16), gl_CooperativeMatrixLayoutRowMajor);
    coopMatLoad(cb, b, uint(0), uint(16), gl_CooperativeMatrixLayoutColumnMajor);
    acc = coopMatMulAdd(ca, cb, acc);
    coopMatStore(acc, c, uint(0), uint(16), gl_CooperativeMatrixLayoutRowMajor);
}
