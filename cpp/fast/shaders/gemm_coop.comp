#version 450
// gemm_coop.comp — C = A · Bᵀ on the VK_KHR_cooperative_matrix path.
//
// Same contract as gemm.comp (same push constant block, same epilogues), but
// the register-tile FMA loop is replaced by hardware cooperative-matrix
// multiplies: f16 A/B operands, f32 accumulation. One workgroup = one
// subgroups computes a BM x BN = 64 x 64 output tile from four 64x16x16
// accumulator matrices per BK = 32-deep K slice. Operands are staged in
// workgroup memory exactly like the scalar kernel (dequantized W4 / W8 /
// F16 / F16ᵀ B tiles, zero-padded at the M / N / K edges), the result lands
// in an f32 staging tile, and the familiar fused epilogues run from there.
//
// Requires: subgroup size 128 (one subgroup per workgroup), coopmat
// 64x16x16 and 16x16x16 with A/B f16 and f32 accumulate, shaderFloat16.
// Selected per device by the host; gemm.comp remains the portable path.
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_memory_scope_semantics : require

#include "common.glsl"

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint EPI = 0;
layout(constant_id = 2) const uint ACT = 0;
layout(constant_id = 3) const uint HAS_BIAS = 0;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

const uint BM = 64, BN = 64, BK = 32;

layout(std430, binding = 0) readonly buffer ABuf { uint a_w[]; };
layout(std430, binding = 0) readonly buffer ABuf4 { uvec4 a_w4[]; };
layout(std430, binding = 1) readonly buffer BQ { uint bq[]; };
layout(std430, binding = 1) readonly buffer BQ4 { uvec4 bq4[]; };
layout(std430, binding = 2) readonly buffer BS { uint bs[]; };
layout(std430, binding = 3) buffer CBuf { uint c_w[]; };
layout(std430, binding = 4) buffer Bias { float bias[]; };
layout(std430, binding = 5) readonly buffer Bias2 { float bias2[]; };
layout(std430, binding = 6) buffer C2Buf { uint c2_w[]; };

layout(push_constant) uniform PC {
    uint M, N, K;
    uint lda, ldb, ldc;
    uint a_off, b_off, c_off;
    uint nb_lo;
    uint sa_hi, sa_lo, sb_hi, sb_lo, sc_hi, sc_lo;
    uint gqa;
    uint row_valid;
    float alpha;
    uint mdiv, ldc_mhi;
    uint ldc_n;
    uint bias_mod;
    uint cv_cin, cv_ti, cv_fi, cv_to, cv_fo;
} p;

// A tile: row-major [BM, BK] f16 (A[m][k] at m * BK + k — RowMajor [M, K]).
shared float16_t As[BM * BK];
// B tile: [BN, BK] f16 (B[k][n] at n * BK + k — ColumnMajor [K, N]).
shared float16_t Bs[BN * BK];
// f32 result staging, row-major [BM, BN].


uint half_bits(uvec4 v, uint h) { return (v[h >> 1] >> (16u * (h & 1u))) & 0xffffu; }

uvec4 load8_a(uint m, uint k, uint base) {
    if (m < p.M && k + 8 <= p.K) return a_w4[(base + m * p.lda + k) >> 3];
    uvec4 r = uvec4(0);
    if (m < p.M)
        for (uint i = 0; i < 8; ++i)
            if (k + i < p.K) {
                const uint e = base + m * p.lda + k + i;
                r[i >> 1] |= ((a_w[e >> 1] >> (16u * (e & 1u))) & 0xffffu) << (16u * (i & 1u));
            }
    return r;
}
uvec4 load8_b(uint n, uint k, uint base) {
    if (n < p.N && k + 8 <= p.K && ((base + n * p.ldb + k) & 7u) == 0u) return bq4[(base + n * p.ldb + k) >> 3];
    uvec4 r = uvec4(0);
    if (n < p.N)
        for (uint i = 0; i < 8; ++i)
            if (k + i < p.K) {
                const uint e = base + n * p.ldb + k + i;
                r[i >> 1] |= ((bq[e >> 1] >> (16u * (e & 1u))) & 0xffffu) << (16u * (i & 1u));
            }
    return r;
}

void main() {
    const uint tid = gl_LocalInvocationID.x;
    const uint m0 = gl_WorkGroupID.x * BM;
    const uint n0 = gl_WorkGroupID.y * BN;
    const uint z = gl_WorkGroupID.z;
    const uint zhi = z / p.nb_lo, zlo = z % p.nb_lo;
    const uint a_base = p.a_off + zhi * p.sa_hi + zlo * p.sa_lo;
    const uint b_base = p.b_off + zhi * p.sb_hi + (zlo / p.gqa) * p.sb_lo;
    const uint c_base = p.c_off + zhi * p.sc_hi + zlo * p.sc_lo;



    const uint n_k = (p.K + BK - 1) / BK;
    for (uint kt = 0; kt < n_k; ++kt) {
        barrier();
    }
    coopmat<float, gl_ScopeSubgroup, BM, 16, gl_MatrixUseAccumulator> dummyacc =
        coopmat<float, gl_ScopeSubgroup, BM, 16, gl_MatrixUseAccumulator>(0.0f);

    // ---- stage the f32 results, then run the shared epilogue ----
    coopMatStore(dummyacc, bias, 0, BN, gl_CooperativeMatrixLayoutRowMajor);
    barrier();

    for (uint u = tid * 4; u < BM * BN; u += WG * 4) {
        const uint m = m0 + u / BN;
        if (m >= p.M) continue;
        const uint n4 = n0 + u % BN;
        const bool live = m < p.row_valid;
        const uint row = c_base + (m / p.mdiv) * p.ldc_mhi + (m % p.mdiv) * p.ldc;
        float v[4];
        [[unroll]] for (uint j = 0; j < 4; ++j) {
            const uint n = n4 + j;
            float x = live ? 0.0 * p.alpha : 0.0;
            if (HAS_BIAS == 1u && n < p.N) x += bias[n];
            if (HAS_BIAS == 2u) x += bias[m];
            if (HAS_BIAS == 3u && n < p.N) x += bias[(m % p.bias_mod) * p.N + n];
            v[j] = x;
        }
        if (EPI == 0u) {
            [[unroll]] for (uint j = 0; j < 4; ++j) {
                const uint n = n4 + j;
                if (n < p.N) c_w[row + n * p.ldc_n] = floatBitsToUint(apply_act(ACT, v[j]));
            }
        } else if (EPI == 2u) {
            [[unroll]] for (uint j = 0; j < 4; ++j) {
                const uint n = n4 + j;
                if (n < p.N) {
                    const uint idx = row + n * p.ldc_n;
                    c_w[idx] = floatBitsToUint(uintBitsToFloat(c_w[idx]) + apply_act(ACT, v[j]));
                }
            }
        } else if (EPI == 1u) {
            [[unroll]] for (uint j = 0; j < 4; j += 2) {
                const uint n = n4 + j;
                if (n < p.N)
                    c_w[(row + n) >> 1] = packHalf2x16(vec2(apply_act(ACT, v[j]), apply_act(ACT, v[j + 1])));
            }
        } else if (EPI == 3u || EPI == 4u) {
            if (n4 < p.N) {
                float o0 = 0.0, o1 = 0.0;
                if (!live) {
                    // padded rows stay exactly zero (NeMo masks after GLU)
                } else if (EPI == 3u) {
                    o0 = v[0] * sigmoid_f(v[1]);
                    o1 = v[2] * sigmoid_f(v[3]);
                } else {
                    o0 = silu_f(v[0]) * v[1];
                    o1 = silu_f(v[2]) * v[3];
                }
                c_w[(row + (n4 >> 1)) >> 1] = packHalf2x16(vec2(o0, o1));
            }
        } else if (EPI == 5u) {
            [[unroll]] for (uint j = 0; j < 4; j += 2) {
                const uint n = n4 + j;
                if (n < p.N) {
                    const float r0 = live ? 0.0 * p.alpha : 0.0;
                    const float r1 = live ? 0.0 * p.alpha : 0.0;
                    c_w[(row + n) >> 1] = packHalf2x16(vec2(r0 + bias[n], r1 + bias[n + 1]));
                    c2_w[(row + n) >> 1] = packHalf2x16(vec2(r0 + bias2[n], r1 + bias2[n + 1]));
                }
            }
        }
    }
}
