#version 450
#extension GL_EXT_control_flow_attributes : enable
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
// f16dot_probe.comp — f16vec4 dot issue-rate probe (no memory traffic):
// chains of dot(f16vec4, f16vec4) to price the f16 dot against the f32 FMA
// (alu_probe) and the i8 SDot (idot_probe) on the same machine.
layout(local_size_x = 128) in;
layout(std430, binding = 0) buffer Out { float o[]; };
layout(push_constant) uniform PC { uint iters; } p;
void main() {
    float16_t a0 = float16_t(float(gl_LocalInvocationID.x) * 1e-6 + 1.0);
    float16_t b0 = float16_t(1.0006);
    f16vec4 acc[32];
    [[unroll]] for (uint i = 0; i < 32; ++i)
        acc[i] = f16vec4(a0 + float16_t(i), a0, a0, a0);
    for (uint it = 0; it < p.iters; ++it) {
        [[unroll]] for (uint i = 0; i < 32; ++i)
            acc[i] += f16vec4(dot(acc[i], f16vec4(b0)));
    }
    float16_t s = float16_t(0.0);
    [[unroll]] for (uint i = 0; i < 32; ++i) s += acc[i].x + acc[i].y + acc[i].z + acc[i].w;
    o[gl_GlobalInvocationID.x] = float(s);
}
