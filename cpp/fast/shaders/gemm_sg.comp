#version 450
// gemm_sg.comp — C = A · Bᵀ without shared memory: the subgroup-broadcast GEMM
// (the structure of LiteRT/ML Drift's PowerVR matmul).
//
// Operands, push constants and epilogues are gemm.comp's (B_W4 / B_W8 / B_F16
// weights or activations, A_CONV implicit 3x3/s2 im2col, batching over z,
// EPI 0..5, ACT, HAS_BIAS 0..3, row_valid, alpha, mdiv/ldc_mhi, causal skip).
//
// Work split: one thread per row m of A, NB = 16 output columns per
// workgroup (x), WG rows per workgroup (y; WG = the subgroup size). For every
// 8-deep k chunk, lane j < NB of each subgroup loads the 8 weights of column
// n0 + j and dequantizes them to f32; subgroupBroadcast(w, j) hands them to
// every lane as uniform operands, and each thread accumulates
// dot(A[m][k..k+7], w) per column in f32. No shared memory, no barriers;
// every weight is dequantized once per workgroup instead of once per use.
// A is read per thread: through the texture path (ATEX, a uniform texel
// buffer of 8-half texels; the host keeps each dispatch inside
// maxTexelBufferElements and passes the view's first texel in a_tex0) or
// from the storage buffer.
//
// Accumulation order differs from gemm.comp (two 4-term dots per chunk), so
// results are not bit-identical to it; both accumulate f16 operands in f32.

#include "common.glsl"
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_ballot : require

layout(constant_id = 0) const uint WG = 128;
layout(constant_id = 1) const uint EPI = 0;
layout(constant_id = 2) const uint ACT = 0;
layout(constant_id = 3) const uint HAS_BIAS = 0;
layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;

#define NB 16

#ifdef ATEX
layout(binding = 0) uniform usamplerBuffer a_tex;
#else
layout(std430, binding = 0) readonly buffer ABuf4 { uvec4 a_w4[]; };
#endif
layout(std430, binding = 1) readonly buffer BQ { uint bq[]; };
layout(std430, binding = 1) readonly buffer BQ4 { uvec4 bq4[]; };
layout(std430, binding = 2) readonly buffer BS { uint bs[]; };
layout(std430, binding = 3) buffer CBuf { uint c_w[]; };
layout(std430, binding = 4) readonly buffer Bias { float bias[]; };
layout(std430, binding = 5) readonly buffer Bias2 { float bias2[]; };
layout(std430, binding = 6) buffer C2Buf { uint c2_w[]; };

layout(push_constant) uniform PC {
    uint M, N, K;
    uint lda, ldb, ldc;
    uint a_off, b_off, c_off;
    uint nb_lo;
    uint sa_hi, sa_lo, sb_hi, sb_lo, sc_hi, sc_lo;
    uint gqa;
    uint row_valid;
    float alpha;
    uint mdiv, ldc_mhi;
    uint ldc_n;
    uint bias_mod;
    uint cv_cin, cv_ti, cv_fi, cv_to, cv_fo;
    uint causal;
    // gemm_sg only: first texel of the A view (ATEX), first row of this dispatch.
    uint a_tex0, m_first;
} p;

// 8 halves of A at element e (8-aligned), as raw bits.
uvec4 load_a8(uint e) {
#ifdef ATEX
    return texelFetch(a_tex, int((e >> 3) - p.a_tex0));
#else
    return a_w4[e >> 3];
#endif
}

#define J16(X) X(0) X(1) X(2) X(3) X(4) X(5) X(6) X(7) X(8) X(9) X(10) X(11) X(12) X(13) X(14) X(15)

void main() {
    const uint lane = gl_SubgroupInvocationID;
    const uint mw = p.m_first + gl_WorkGroupID.y * WG;       // first row of the workgroup
    const uint m = mw + gl_LocalInvocationID.x;
    const uint n0 = gl_WorkGroupID.x * NB;
    const uint z = gl_WorkGroupID.z;
    const uint zhi = z / p.nb_lo, zlo = z % p.nb_lo;
    const uint a_base = p.a_off + zhi * p.sa_hi + zlo * p.sa_lo;
    const uint b_base = p.b_off + zhi * p.sb_hi + (zlo / p.gqa) * p.sb_lo;
    const uint c_base = p.c_off + zhi * p.sc_hi + zlo * p.sc_lo;
#if defined(B_F16) && !defined(A_CONV)
    // Causal scores: a column block wholly above the workgroup's diagonal is
    // never read by the softmax.
    if (p.causal != 0xffffffffu && n0 > mw + WG - 1u + p.causal) return;
#endif
    const uint mr = min(m, p.M - 1u);                        // rows past M read row M-1
    const uint nl = n0 + lane;                               // the column this lane loads
    const bool loader = lane < NB && nl < p.N;

    float acc[NB];
    [[unroll]] for (uint j = 0; j < NB; ++j) acc[j] = 0.0;

#ifdef A_CONV
    // Implicit im2col of a 3x3 / stride-2 / pad-1 conv over [chunk][t][f][cin]:
    // row m = (chunk, to, fo), k = (kt * 3 + kf) * cin + ic. The k walk is
    // sequential, so the tap and channel advance incrementally.
    const uint per_chunk = p.cv_to * p.cv_fo;
    const uint chunk = mr / per_chunk, rem = mr % per_chunk;
    const uint to = rem / p.cv_fo, fo = rem % p.cv_fo;
    uint tap = 0, ic = 0;
#else
    const uint a_row = a_base + mr * p.lda;
#endif
    const uint G = p.K / 32;
    const uint n_k8 = p.K / 8;
    for (uint k8 = 0; k8 < n_k8; ++k8) {
        // ---- this lane's 8 weights of column nl, dequantized ----
        vec4 w0 = vec4(0.0), w1 = vec4(0.0);
        if (loader) {
#if defined(B_W4)
            const uint g = nl * G + (k8 >> 2);
            const vec2 so = unpackHalf2x16(bs[g]);
            const uint q = bq[g * 4 + (k8 & 3u)];
            w0 = so.x * vec4(q & 15u, (q >> 4) & 15u, (q >> 8) & 15u, (q >> 12) & 15u) + so.y;
            w1 = so.x * vec4((q >> 16) & 15u, (q >> 20) & 15u, (q >> 24) & 15u, q >> 28) + so.y;
#elif defined(B_W8)
            const uint g = nl * G + (k8 >> 2);
            const float s = unpackHalf2x16(bs[g])[(k8 >> 1) & 1u];
            const int q0 = int(bq[g * 8 + (k8 & 3u) * 2]), q1 = int(bq[g * 8 + (k8 & 3u) * 2 + 1]);
            w0 = s * vec4(bitfieldExtract(q0, 0, 8), bitfieldExtract(q0, 8, 8), bitfieldExtract(q0, 16, 8), bitfieldExtract(q0, 24, 8));
            w1 = s * vec4(bitfieldExtract(q1, 0, 8), bitfieldExtract(q1, 8, 8), bitfieldExtract(q1, 16, 8), bitfieldExtract(q1, 24, 8));
#else   // B_F16 (8-aligned, host-checked)
            const uvec4 h = bq4[(b_base + nl * p.ldb + 8u * k8) >> 3];
            w0 = vec4(unpackHalf2x16(h.x), unpackHalf2x16(h.y));
            w1 = vec4(unpackHalf2x16(h.z), unpackHalf2x16(h.w));
#endif
        }
        // ---- this thread's 8 values of row m ----
#ifdef A_CONV
        uvec4 av = uvec4(0);
        {
            const int ti = int(2u * to + tap / 3u) - 1, fi = int(2u * fo + tap % 3u) - 1;
            if (ti >= 0 && ti < int(p.cv_ti) && fi >= 0 && fi < int(p.cv_fi))
                av = load_a8(a_base + ((chunk * p.cv_ti + uint(ti)) * p.cv_fi + uint(fi)) * p.cv_cin + ic);
            ic += 8u;
            if (ic == p.cv_cin) { ic = 0u; ++tap; }
        }
#else
        const uvec4 av = load_a8(a_row + 8u * k8);
#endif
        const vec4 a0 = vec4(unpackHalf2x16(av.x), unpackHalf2x16(av.y));
        const vec4 a1 = vec4(unpackHalf2x16(av.z), unpackHalf2x16(av.w));
#define COL(j) acc[j] += dot(a0, subgroupBroadcast(w0, j)) + dot(a1, subgroupBroadcast(w1, j));
        J16(COL)
#undef COL
    }

    // ---- epilogue (gemm.comp's, per row, NB columns) ----
    if (m >= p.M) return;
    const bool live = m < p.row_valid;
    const uint row = c_base + (m / p.mdiv) * p.ldc_mhi + (m % p.mdiv) * p.ldc;
    float v[NB];
    [[unroll]] for (uint j = 0; j < NB; ++j) {
        const uint n = n0 + j;
        float x = live ? acc[j] * p.alpha : 0.0;
        if (HAS_BIAS == 1u && n < p.N) x += bias[n];
        if (HAS_BIAS == 2u) x += bias[m];
        if (HAS_BIAS == 3u && n < p.N) x += bias[(m % p.bias_mod) * p.N + n];
        v[j] = x;
    }
    if (EPI == 0u) {
        [[unroll]] for (uint j = 0; j < NB; ++j) {
            const uint n = n0 + j;
            if (n < p.N) c_w[row + n * p.ldc_n] = floatBitsToUint(apply_act(ACT, v[j]));
        }
    } else if (EPI == 2u) {
        [[unroll]] for (uint j = 0; j < NB; ++j) {
            const uint n = n0 + j;
            if (n < p.N) {
                const uint idx = row + n * p.ldc_n;
                c_w[idx] = floatBitsToUint(uintBitsToFloat(c_w[idx]) + apply_act(ACT, v[j]));
            }
        }
    } else if (EPI == 1u) {
        // f16 pairs; N, row and n0 are even (host-checked).
        [[unroll]] for (uint j = 0; j < NB; j += 2) {
            const uint n = n0 + j;
            if (n < p.N)
                c_w[(row + n) >> 1] = packHalf2x16(vec2(apply_act(ACT, v[j]), apply_act(ACT, v[j + 1])));
        }
    } else if (EPI == 3u || EPI == 4u) {
        // Interleaved pairs -> one output per pair; 4 columns -> one packed word.
        [[unroll]] for (uint j = 0; j < NB; j += 4) {
            const uint n = n0 + j;
            if (n < p.N) {
                float o0 = 0.0, o1 = 0.0;
                if (!live) {
                    // padded rows stay exactly zero (NeMo masks after GLU)
                } else if (EPI == 3u) {
                    o0 = v[j] * sigmoid_f(v[j + 1]);
                    o1 = v[j + 2] * sigmoid_f(v[j + 3]);
                } else {
                    o0 = silu_f(v[j]) * v[j + 1];
                    o1 = silu_f(v[j + 2]) * v[j + 3];
                }
                c_w[(row + (n >> 1)) >> 1] = packHalf2x16(vec2(o0, o1));
            }
        }
    } else if (EPI == 5u) {
        [[unroll]] for (uint j = 0; j < NB; j += 2) {
            const uint n = n0 + j;
            if (n < p.N) {
                const float r0 = live ? acc[j] * p.alpha : 0.0;
                const float r1 = live ? acc[j + 1] * p.alpha : 0.0;
                c_w[(row + n) >> 1] = packHalf2x16(vec2(r0 + bias[n], r1 + bias[n + 1]));
                c2_w[(row + n) >> 1] = packHalf2x16(vec2(r0 + bias2[n], r1 + bias2[n + 1]));
            }
        }
    }
}
