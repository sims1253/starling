+// ---- Optional per-op-type GPU timing (parakeet instrumentation). ----
+// Gated by PARAKEET_PEROP_TIMING. When set AND graphs are disabled
+// (GGML_CUDA_DISABLE_GRAPHS=1, so every node goes through the per-node
+// ggml_cuda_compute_forward path below rather than a captured/replayed CUDA
+// graph), record a CUDA event pair around each node's forward and accumulate
+// elapsed GPU ms per op type (node->op). After each graph_compute prints a
+// table: op_type, total_ms, calls, ms/call, % of this graph's measured GPU
+// time, and the count of src-fp16 vs src-f32 matmuls. Off by default -> zero
+// effect on the steady-state byte-exact path.
+//
+// NOTE: requires GGML_CUDA_DISABLE_GRAPHS=1 because per-node events recorded
+// during cudaStreamBeginCapture are NOT emitted on cudaGraphLaunch replay.
+struct pk_per_op_stat {
+    double total_ms = 0.0;
+    uint64_t calls  = 0;
+};
+static std::unordered_map<int, pk_per_op_stat> & pk_perop_stats() {
+    static std::unordered_map<int, pk_per_op_stat> s;
+    return s;
+}
+// Unguarded tally of EVERY node iterated in the per-node loop (regardless of
+// skip/fuse/flag), for diagnosing why certain op types are absent from the
+// timed table. Only populated when PARAKEET_PEROP_TIMING is set.
+static std::unordered_map<int, uint64_t> & pk_perop_seen() {
+    static std::unordered_map<int, uint64_t> s;
+    return s;
+}
+// Per-op size inventory: op -> (count, total dst elements, sample shape). Lets
+// us judge fusion value (big tensors = more worth fusing / fewer = overhead).
+struct pk_size_stat { uint64_t count = 0; double sum_elems = 0.0; std::string sample; };
+static std::unordered_map<int, pk_size_stat> & pk_size_inv() {
+    static std::unordered_map<int, pk_size_stat> s;
+    return s;
+}
+// Why an iterated node did NOT get timed: keyed by reason -> (op -> count).
+//   noop:    hit the reshape/transpose/view/permute/none/empty early-out
+//   no_flag: GGML_TENSOR_FLAG_COMPUTE was not set
+//   fused:   ggml_cuda_try_fuse returned nonzero (handled by a fused kernel)
+static std::unordered_map<std::string, std::unordered_map<int, uint64_t>> & pk_skip_reason() {
+    static std::unordered_map<std::string, std::unordered_map<int, uint64_t>> s;
+    return s;
+}
+// Deferred per-node timing records: (op, start_event, end_event). We record a
+// CUDA event pair around each node WITHOUT syncing, then drain the whole list
+// with a single sync after the graph compute. This lets the GPU pipeline keep
+// overlapping kernels (a per-node cudaEventSynchronize would serialize them
+// and badly distort the relative breakdown).
+struct pk_node_event {
+    int       op;
+    cudaEvent_t ev0;
+    cudaEvent_t ev1;
+};
+static std::vector<pk_node_event> & pk_node_events() {
+    static std::vector<pk_node_event> v;
+    return v;
+}
+// Drain the deferred event list: sync the last event once, then read every
+// elapsed time and fold it into the per-op accumulator. Destroys the events.
+static void pk_drain_node_events() {
+    auto & evs = pk_node_events();
+    if (evs.empty()) return;
+    // Sync the last end event -> all earlier events are guaranteed complete.
+    CUDA_CHECK(cudaEventSynchronize(evs.back().ev1));
+    for (const auto & e : evs) {
+        float ms = 0.0f;
+        CUDA_CHECK(cudaEventElapsedTime(&ms, e.ev0, e.ev1));
+        auto & s = pk_perop_stats()[(int) e.op];
+        s.total_ms += (double) ms;
+        s.calls    += 1;
+        CUDA_CHECK(cudaEventDestroy(e.ev0));
+        CUDA_CHECK(cudaEventDestroy(e.ev1));
+    }
+    evs.clear();
+}
+static bool pk_perop_enabled() {
+    static const bool on = getenv("PARAKEET_PEROP_TIMING") != nullptr;
+    return on;
+}
+static void pk_perop_print_and_reset(const char * tag, int n_nodes, uint32_t uid) {
+    auto & stats = pk_perop_stats();
+    double grand = 0.0;
+    for (const auto & kv : stats) grand += kv.second.total_ms;
+    fprintf(stderr,
+        "[perop] === %s n_nodes=%d uid=%u measured_total=%.3fms ===\n",
+        tag, n_nodes, (unsigned)uid, grand);
+    if (grand <= 0.0) return;
+    std::vector<std::pair<int, pk_per_op_stat>> rows(stats.begin(), stats.end());
+    std::sort(rows.begin(), rows.end(),
+        [](const auto & a, const auto & b){ return a.second.total_ms > b.second.total_ms; });
+    fprintf(stderr, "[perop] %-22s %10s %8s %10s %7s\n",
+        "op", "total_ms", "calls", "ms/call", "pct");
+    for (const auto & r : rows) {
+        if (r.second.calls == 0) continue;
+        // Synthetic fused bucket key: 0x40000000 | lead_op.
+        std::string label;
+        if ((r.first & 0x40000000) != 0) {
+            label = std::string("FUSED_") + ggml_op_name((enum ggml_op)(r.first & ~0x40000000));
+        } else {
+            label = ggml_op_name((enum ggml_op) r.first);
+        }
+        fprintf(stderr, "[perop] %-22s %10.4f %8llu %10.5f %6.2f%%\n",
+            label.c_str(),
+            r.second.total_ms,
+            (unsigned long long) r.second.calls,
+            r.second.total_ms / (double) r.second.calls,
+            100.0 * r.second.total_ms / grand);
+    }
+    stats.clear();
+    // Dump the unguarded node tally (every node iterated, incl. skipped/fused).
+    auto & seen = pk_perop_seen();
+    std::vector<std::pair<int, uint64_t>> srows(seen.begin(), seen.end());
+    std::sort(srows.begin(), srows.end(),
+        [](const auto & a, const auto & b){ return a.second > b.second; });
+    uint64_t seen_total = 0;
+    for (const auto & r : srows) seen_total += r.second;
+    fprintf(stderr, "[perop] --- node distribution (all %llu iterated nodes) ---\n",
+        (unsigned long long) seen_total);
+    for (const auto & r : srows) {
+        fprintf(stderr, "[perop] %-22s seen=%llu\n",
+            ggml_op_name((enum ggml_op) r.first),
+            (unsigned long long) r.second);
+    }
+    seen.clear();
+    // Dump per-op size inventory (avg dst elements + sample shape per op type).
+    auto & inv = pk_size_inv();
+    fprintf(stderr, "[perop] --- per-op size inventory (count, avg dst elems, sample) ---\n");
+    for (const auto & kv : inv) {
+        double avg = kv.second.count ? (kv.second.sum_elems / (double) kv.second.count) : 0.0;
+        fprintf(stderr, "[perop] %-22s count=%-4llu avgElems=%.0f sample=%s\n",
+            ggml_op_name((enum ggml_op) kv.first),
+            (unsigned long long) kv.second.count, avg, kv.second.sample.c_str());
+    }
+    inv.clear();
+    // Dump skip reasons (why iterated nodes did not get timed).
+    auto & skips = pk_skip_reason();
+    fprintf(stderr, "[perop] --- skip reasons (why nodes seen but not timed) ---\n");
+    for (const auto & kv : skips) {
+        for (const auto & op_c : kv.second) {
+            fprintf(stderr, "[perop] %-10s %-22s count=%llu\n",
+                kv.first.c_str(),
+                ggml_op_name((enum ggml_op) op_c.first),
+                (unsigned long long) op_c.second);
+        }
+    }
+    skips.clear();
+}
+
 static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cuda_ctx, ggml_cgraph * cgraph, const bool use_cuda_graph, const bool cuda_graph_update_required, const void * graph_key) {
     bool graph_evaluated_or_captured = false;
 
@@ -4320,6 +4525,22 @@ static void ggml_cuda_graph_evaluate_and_capture(ggml_backend_cuda_context * cud
 
             for (int i = 0; i < cgraph->n_nodes; i++) {
                 ggml_tensor * node = cgraph->nodes[i];
+                if (pk_perop_enabled()) {
