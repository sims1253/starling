From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Maximilian Scholz <dev.scholz@mailbox.org>
Date: Tue, 27 Oct 2026 08:55:39 +0100
Subject: [PATCH] cuda fattn per head additive mask

---
 src/ggml-cuda/fattn-mma-f16.cuh | 14 ++++++++++----
 src/ggml-cuda/fattn.cu          | 32 +++++++++++++++++++++++++++-----
 2 files changed, 37 insertions(+), 9 deletions(-)

diff --git a/src/ggml-cuda/fattn-mma-f16.cuh b/src/ggml-cuda/fattn-mma-f16.cuh
index 296aa2b3..da119d52 100644
--- a/src/ggml-cuda/fattn-mma-f16.cuh
+++ b/src/ggml-cuda/fattn-mma-f16.cuh
@@ -1918,8 +1918,11 @@ static __global__ void flash_attn_ext_f16(
 
         const float2 * Q_f2   = (const float2 *) (Q + nb03*sequence + nb02*zt_Q);
         const half2  * K_h2   = (const half2  *) (K + nb13*sequence + nb12*z_KV);
-        const half   * mask_h = ncols2 == 1 && !mask ? nullptr :
-            (const half *) (mask + nb33*(sequence % ne33));
+        // For a per-head mask (ne32 == ne02 == n_head) index mask[zt_Q]; for a
+        // broadcast mask (ne32 == 1) ne32-conditional offset is 0 (head stride ignored).
+        const int     mask_h_offs = ne32 == 1 ? 0 : nb32*zt_Q;
+        const half  * mask_h = ncols2 == 1 && !mask ? nullptr :
+            (const half *) (mask + nb33*(sequence % ne33) + mask_h_offs);
         float2       * dstk   = ((float2 *) dst) + (sequence*ne01.z*ne02 + zt_Q) * (DV/2);
 
         const half2 * V_h2 = V_is_K_view ? K_h2 : (const half2 *) (V + nb23*sequence + nb22*z_KV);
@@ -1967,8 +1970,11 @@ static __global__ void flash_attn_ext_f16(
 
     const float2 * Q_f2   = (const float2 *) (Q + nb03*sequence + nb02*zt_Q);
     const half2  * K_h2   = (const half2  *) (K + nb13*sequence + nb12*z_KV);
-    const half   * mask_h = ncols2 == 1 && !mask ? nullptr :
-        (const half *) (mask + nb33*(sequence % ne33));
+    // For a per-head mask (ne32 == ne02 == n_head) index mask[zt_Q]; for a
+    // broadcast mask (ne32 == 1) the ne32-conditional offset is 0.
+    const int     mask_h_offs = ne32 == 1 ? 0 : nb32*zt_Q;
+    const half  * mask_h = ncols2 == 1 && !mask ? nullptr :
+        (const half *) (mask + nb33*(sequence % ne33) + mask_h_offs);
     float2       * dstk   = ((float2 *) dst) + (sequence*ne01.z*ne02 + zt_Q) * (DV/2);
 
     const half2 * V_h2 = V_is_K_view ? K_h2 : (const half2 *) (V + nb23*sequence + nb22*z_KV);
diff --git a/src/ggml-cuda/fattn.cu b/src/ggml-cuda/fattn.cu
index 5fa3e530..1476d45a 100644
--- a/src/ggml-cuda/fattn.cu
+++ b/src/ggml-cuda/fattn.cu
@@ -202,9 +202,10 @@ static void ggml_cuda_flash_attn_ext_mma_f16_switch_ncols2(ggml_backend_cuda_con
     float max_bias = 0.0f;
     memcpy(&max_bias, (const float *) KQV->op_params + 1, sizeof(float));
 
-    // Edge cases like no mask, ALiBi, unpadded K/V, or misaligned addresses for large data transfers
+    // Edge cases like no mask, ALiBi, unpadded K/V, misaligned addresses for large data transfers,
+    //     or a per-head mask (mask[h] indexing is incompatible with GQA ncols2 batching)
     //     are put into the template specialization without GQA optimizations.
-    bool use_gqa_opt = mask && max_bias == 0.0f && K->ne[1] % FATTN_KQ_STRIDE == 0;
+    bool use_gqa_opt = mask && mask->ne[2] == 1 && max_bias == 0.0f && K->ne[1] % FATTN_KQ_STRIDE == 0;
     for (const ggml_tensor * t : {Q, K, V, mask}) {
         if (t == nullptr || ggml_is_quantized(t->type)) {
             continue;
@@ -557,7 +558,8 @@ static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const
 
     // The effective batch size for the kernel can be increased by gqa_ratio.
     // The kernel versions without this optimization are also used for ALiBi, if there is no mask, or if the KV cache is not padded,
-    bool gqa_opt_applies = gqa_ratio >= 2 && mask && max_bias == 0.0f && K->ne[1] % FATTN_KQ_STRIDE == 0;
+    // or if the mask is per-head (mask[h] indexing is incompatible with the GQA ncols2 batching).
+    bool gqa_opt_applies = gqa_ratio >= 2 && mask && mask->ne[2] == 1 && max_bias == 0.0f && K->ne[1] % FATTN_KQ_STRIDE == 0;
     for (const ggml_tensor * t : {Q, K, V, mask}) {
         if (t == nullptr || ggml_is_quantized(t->type)) {
             continue;
@@ -625,13 +627,23 @@ static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const
         return BEST_FATTN_KERNEL_NONE;
     }
 
-    if (mask && mask->ne[2] != 1) {
+    // Support two mask shapes:
+    //   (1) broadcast mask: ne[2] == 1, applied identically to every head (the
+    //       common case for causal/ALiBi/padding masks). All kernels support it.
+    //   (2) per-head mask:  ne[2] == Q->ne[2] (== n_head), a distinct additive
+    //       bias per head (e.g. NeMo rel-pos attention bias bd[T_k,T_q,H]).
+    //       Only the MMA tensor-core kernel indexes mask[h]; the VEC and TILE
+    //       kernels do not, so they are rejected below for this case.
+    const bool mask_is_broadcast = !mask || mask->ne[2] == 1;
+    const bool mask_is_per_head  = mask && mask->ne[2] == Q->ne[2];
+    if (mask && !mask_is_broadcast && !mask_is_per_head) {
         return BEST_FATTN_KERNEL_NONE;
     }
 
     // For small batch sizes the vector kernel may be preferable over the kernels optimized for large batch sizes:
     // 192 satisfies % 64 == 0 but has no vec instance (DKQ != DV); force it onto the MMA path.
-    const bool can_use_vector_kernel = Q->ne[0] <= 256 && Q->ne[0] % 64 == 0 && Q->ne[0] != 192 && K->ne[1] % FATTN_KQ_STRIDE == 0;
+    const bool can_use_vector_kernel = mask_is_broadcast
+        && Q->ne[0] <= 256 && Q->ne[0] % 64 == 0 && Q->ne[0] != 192 && K->ne[1] % FATTN_KQ_STRIDE == 0;
 
     // If Turing tensor cores are available, use them:
     if (turing_mma_available(cc) && Q->ne[0] != 40 && Q->ne[0] != 72) {
@@ -673,6 +685,10 @@ static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const
         if (can_use_vector_kernel && Q->ne[1] * gqa_ratio_eff <= 2) {
             return BEST_FATTN_KERNEL_VEC;
         }
+        if (mask_is_per_head) {
+            // The tile kernel does not index mask[h]; per-head masks must use MMA.
+            return BEST_FATTN_KERNEL_MMA_F16;
+        }
         if (Q->ne[1] * gqa_ratio_eff <= 16) {
             return BEST_FATTN_KERNEL_TILE; // On Volta tensor cores are only faster for sufficiently large matrices.
         }
@@ -715,6 +731,12 @@ static best_fattn_kernel ggml_cuda_get_best_fattn_kernel(const int device, const
             }
         }
     }
+    // The tile kernel does not index mask[h]; a per-head additive mask requires
+    // the MMA tensor-core kernel. If none of those was selected, refuse (aborting
+    // loudly) rather than silently producing wrong results.
+    if (mask_is_per_head) {
+        return BEST_FATTN_KERNEL_NONE;
+    }
     return BEST_FATTN_KERNEL_TILE;
 }
 
