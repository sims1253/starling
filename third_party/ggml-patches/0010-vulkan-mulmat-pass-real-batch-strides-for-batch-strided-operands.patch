From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
Date: Wed, 3 Sep 2026 01:10:00 +0200
Subject: [PATCH] vulkan/mulmat: pass real batch strides for batch-strided operands

ggml_vk_mul_mat_q_f16 and ggml_vk_mul_mat_vec_q_f16 always handed the
matmul shaders stride_batch_x = ne00*ne01 / stride_batch_y = ne10*ne11
when an operand was used in place, i.e. they assumed the batch dims were
contiguous. An operand can be dim01-contiguous and still batch-strided:
the llama.cpp-style static KV cache feeds prefill attention a
[D, S, KV] ggml_cpy result VIEW of the persistent [D, max_cache, KV]
cache, whose nb[2] is D*max_cache, not D*S. With the contiguous stride
passed instead, the shader's batch offset (a single slice stride; dims
2/3 fold via ne02, and the nb[3] == ne[2]*nb[2] half of that fold is
already guaranteed by ggml_vk_dim01_contiguous for in-place tensors)
landed every batch except the first in the wrong slots -- on a zeroed
cache, all kv heads except kv 0 attended to all-zero keys, silently
producing plausible-looking but wrong output.

The !ggml_vk_dim01_contiguous fallbacks that were supposed to cover
strided layouts were unreachable (!dim01_contiguous implies
x/y_non_contig implies *_needs_dequant, which routes through the
contiguous-copy path) and used nb[0], which is not a batch stride at
all. Delete them and instead:

  - pass the real nb[2]-derived element stride (nb[2]/type_size *
    blck_size, which equals ne00*ne01 / ne10*ne11 for every
    batch-contiguous tensor, so contiguous cases are bit-identical)
    for operands that stay in their own buffer;
  - size the in-place SSBO descriptors to the strided extent
    (ggml_nbytes) so batch reads stay inside the descriptor range
    (the GEMV path already used ggml_nbytes via
    ggml_vk_tensor_subbuffer);
  - require 8-divisibility of the in-place batch strides for the
    ALIGNED pipeline variants, whose unchecked vector loads divide
    the batch offset by the load width.

Verified on RADV RENOIR (Ryzen 5 5650U iGPU) with isolated CPU-vs-
Vulkan harnesses (scripts/diagnostics/vulkan/test_batched_mulmat.cpp):
bf16/f32 [128,107,8] x [128,107,16] GQA mul_mat with src0/src1 as
[D,107,KV] views of [128,512,KV] buffers went from maxdiff 15.9/161.5
(every head mapped to kv 0 wrong) to fp-epsilon / pipeline noise, and
the moss + granite engines' stage-by-stage comparators now produce
CPU-identical greedy ids on the default hot path (batched attention,
captured prefill + K-step decode). test_ops and the 0009 bf16-GEMV
harness stay green.

starling-issue: vulkan backend unlock
---
 src/ggml-vulkan/ggml-vulkan.cpp | 78 +++++++++++++++++++++++++++------------
 1 file changed, 54 insertions(+), 24 deletions(-)

diff --git a/src/ggml-vulkan/ggml-vulkan.cpp b/src/ggml-vulkan/ggml-vulkan.cpp
index 860f691..bdc0628 100644
--- a/src/ggml-vulkan/ggml-vulkan.cpp
+++ b/src/ggml-vulkan/ggml-vulkan.cpp
@@ -9240,10 +9240,39 @@ static void ggml_vk_mul_mat_q_f16(ggml_backend_vk_context * ctx, vk_context& sub
     // Not implemented
     GGML_ASSERT(y_non_contig || !qy_needs_dequant);  // NOLINT
 
+    // [starling 0010] Batch strides for the matmul dispatch. An operand that
+    // stays in its own buffer may be batch-strided even when dim01 is
+    // contiguous: a [D,S,KV] ggml_cpy result view of a persistent
+    // [D,max_cache,KV] KV cache has nb[2] = D*max_cache, not D*S. The shader
+    // consumes one slice stride per operand (dims 2/3 fold via ne02; the
+    // nb[3] == ne[2]*nb[2] half of that fold is guaranteed by
+    // ggml_vk_dim01_contiguous for in-place tensors), so pass the real nb[2]
+    // for in-place operands (element units: nb[2]/type_size*blck_size;
+    // equals ne00*ne01 / ne10*ne11 for every batch-contiguous tensor, so the
+    // contiguous cases are bit-identical to the old values). Staged operands
+    // (dequant copy / quantize_y) land in contiguous scratch, keep the
+    // contiguous stride. The previous !dim01_contiguous fallbacks were
+    // unreachable (!dim01_contiguous implies *_non_contig implies
+    // *_needs_dequant) and used nb[0], which is not a batch stride — with a
+    // strided-but-row-contiguous src0 the host silently passed ne00*ne01 and
+    // every batch except the first read wrong memory.
+    const uint32_t stride_batch_x = !qx_needs_dequant
+        ? (uint32_t)(src0->nb[2] * ggml_blck_size(src0->type) / ggml_type_size(src0->type))
+        : (uint32_t)(ne00 * ne01);
+    const uint32_t stride_batch_y = (!qy_needs_dequant && !quantize_y)
+        ? (uint32_t)(src1->nb[2] * ggml_blck_size(src1->type) / ggml_type_size(src1->type))
+        : (uint32_t)(ne10 * ne11);
+
     const ggml_type effective_src1_type = quantize_y ? GGML_TYPE_Q8_1 : (y_f32_kernel ? GGML_TYPE_F32 : src1->type);
 
     const uint32_t kpad = quantize_y ? 0 : ggml_vk_align_size(ne10, ggml_vk_guess_matmul_pipeline_align(ctx, mmp, ne01, ne11, qx_needs_dequant ? f16_type : src0->type, effective_src1_type));
-    const bool aligned = !quantize_y && ne10 == kpad && ne01 > 8 && ne11 > 8;
+    // [starling 0010] The ALIGNED variants do unchecked vector loads whose
+    // batch offsets divide the (possibly strided) batch stride; require
+    // 8-divisibility so a strided view cannot desynchronize the vec indices.
+    // (Contiguous strides are ne10*rows with ne10 % align == 0, so this never
+    // demotes a previously-aligned contiguous case.)
+    const bool aligned = !quantize_y && ne10 == kpad && ne01 > 8 && ne11 > 8 &&
+                         stride_batch_x % 8 == 0 && stride_batch_y % 8 == 0;
 
     vk_pipeline pipeline = ggml_vk_guess_matmul_pipeline(ctx, mmp, ne01, ne11, aligned, qx_needs_dequant ? f16_type : src0->type, effective_src1_type);
 
@@ -9401,21 +9430,16 @@ static void ggml_vk_mul_mat_q_f16(ggml_backend_vk_context * ctx, vk_context& sub
         }
     }
 
-    uint32_t stride_batch_x = ne00*ne01;
-    uint32_t stride_batch_y = ne10*ne11;
-
-    if (!ggml_vk_dim01_contiguous(src0) && !qx_needs_dequant) {
-        stride_batch_x = src0->nb[0] / ggml_type_size(src0->type);
-    }
-
-    if (!ggml_vk_dim01_contiguous(src1) && !qy_needs_dequant && !quantize_y) {
-        stride_batch_y = src1->nb[0] / ggml_type_size(src1->type);
-    }
-
     // compute
+    // [starling 0010] stride_batch_x/y were computed above (real nb[2] for
+    // in-place operands). An in-place operand's SSBO descriptor must cover
+    // the strided extent (ggml_nbytes), not just the leading contiguous
+    // x_sz/y_sz bytes — otherwise batches >= 1 read outside the descriptor
+    // range.
     ggml_vk_matmul(
         ctx, subctx, pipeline,
-        { d_X, x_buf_offset, x_sz }, { d_Y, y_buf_offset, y_sz },
+        { d_X, x_buf_offset, !qx_needs_dequant ? std::max(x_sz, (uint64_t)ggml_nbytes(src0)) : x_sz },
+        { d_Y, y_buf_offset, (!qy_needs_dequant && !quantize_y) ? std::max(y_sz, (uint64_t)ggml_nbytes(src1)) : y_sz },
         ggml_vk_subbuffer(ctx, d_D, d_buf_offset), { ctx->prealloc_split_k, 0, d_sz * split_k },
         ne01, ne11, ne10,
         ne10, ne10, stride_d, stride_batch_x, stride_batch_y, stride_batch_d,
@@ -9547,6 +9571,9 @@ static void ggml_vk_mul_mat_vec_q_f16(ggml_backend_vk_context * ctx, vk_context&
     GGML_ASSERT(ne11 == 1 || ne12 * ne13 == 1);
     bool batch_n = ne11 > 1;
 
+    // [starling 0010] Same as the wide path: nb[3] fold and dim01
+    // contiguity are covered by ggml_vk_dim01_contiguous; the batch stride
+    // itself is passed below.
     const bool x_non_contig = !ggml_vk_dim01_contiguous(src0);
     const bool y_non_contig = !ggml_vk_dim01_contiguous(src1);
 
@@ -9700,19 +9727,22 @@ static void ggml_vk_mul_mat_vec_q_f16(ggml_backend_vk_context * ctx, vk_context&
         ctx->prealloc_y_last_decode_vector_staging = false;
     }
 
-    // For batch_n, the A matrix is the same for each batch, and B/D use the row stride as the batch stride
-    uint32_t stride_batch_x = batch_n ? 0 : ne00*ne01;
-    uint32_t stride_batch_y = batch_n ? ne10 : (ne10*ne11);
+    // For batch_n, the A matrix is the same for each batch, and B/D use the row stride as the batch stride.
+    // [starling 0010] Real nb[2]-derived batch strides for in-place operands
+    // (see ggml_vk_mul_mat_q_f16): a dim01-contiguous src0/src1 may still be
+    // batch-strided (a [D,1,KV] view of a persistent [D,max_cache,KV] KV
+    // cache). Staged operands (dequant copy / quantize_y / the 0009 bf16->f32
+    // upcast) land in contiguous scratch and keep the contiguous stride. The
+    // old !dim01_contiguous fallbacks were unreachable and used nb[0].
+    const uint32_t stride_batch_x = batch_n ? 0 :
+        (!qx_needs_dequant ? (uint32_t)(src0->nb[2] * ggml_blck_size(src0->type) / ggml_type_size(src0->type))
+                           : (uint32_t)(ne00 * ne01));
+    const uint32_t stride_batch_y = batch_n ? (uint32_t)ne10 :
+        (!qy_needs_dequant && !quantize_y && !y_bf16_f32
+            ? (uint32_t)(src1->nb[2] * ggml_blck_size(src1->type) / ggml_type_size(src1->type))
+            : (uint32_t)(ne10 * ne11));
     uint32_t stride_batch_d = batch_n ? ne20 : (ne20*ne21);
 
-    if (!ggml_vk_dim01_contiguous(src0) && !qx_needs_dequant) {
-        stride_batch_x = src0->nb[0] / ggml_type_size(src0->type);
-    }
-
-    if (!ggml_vk_dim01_contiguous(src1) && !qy_needs_dequant) {
-        stride_batch_y = src1->nb[0] / ggml_type_size(src1->type);
-    }
-
     const uint32_t max_groups_x = ctx->device->properties.limits.maxComputeWorkGroupCount[0];
 
     uint32_t groups_x = ne01;
