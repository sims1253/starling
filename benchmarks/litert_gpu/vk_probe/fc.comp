#version 450
// ML Drift's FullyConnected/1x1-conv kernel ("conv_generic" with wave-memory
// weights, as dumped from LiteRT 2.3.0 on the Pixel 10 Pro) ported to Vulkan:
//
// * one subgroup (128 lanes) per workgroup, one thread per token (row of A);
// * workgroup x owns SL output slices (4*SL output channels);
// * no shared memory, no barriers: per pair of input slices, lanes 0..8*SL-1
//   each load one weight vec4 (4 output channels of one input channel) and
//   subgroupBroadcast(w, const) hands them to every lane as uniform operands;
// * A (PHWC4: texel s*M + m = A[m][4s..4s+3]) is read per thread, through the
//   texture path (ATEX=1, uniform texel buffer) or an SSBO (ATEX=0).
//
// Macros: F16 (0/1 arithmetic type), SL (output slices per thread), ATEX.
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : enable
#extension GL_KHR_shader_subgroup_basic : enable
#extension GL_KHR_shader_subgroup_ballot : enable
#extension GL_EXT_shader_subgroup_extended_types_float16 : enable
#extension GL_EXT_control_flow_attributes : enable
layout(local_size_x = 128) in;

#if F16
#define V f16vec4
#else
#define V vec4
#endif

#if ATEX
layout(binding = 0) uniform samplerBuffer At;
#define LOADA(i) V(texelFetch(At, int(i)))
#else
layout(std430, binding = 0) readonly buffer Ab { f16vec4 Ah[]; };
#define LOADA(i) V(Ah[i])
#endif
layout(std430, binding = 1) readonly buffer Wb { f16vec4 W[]; };   // [N/4/SL][K/8][8*SL]
layout(std430, binding = 2) writeonly buffer Cb { vec4 C[]; };      // C[m][n/4] as vec4
layout(push_constant) uniform PC { uint M, K, N; } p;

void main() {
    const uint lane = gl_SubgroupInvocationID;
    const uint m = gl_WorkGroupID.y * 128 + gl_LocalInvocationID.x;
    const uint ds = gl_WorkGroupID.x * SL;          // first output slice
    const uint KS = p.K / 4;                        // input slices
    V acc[SL];
    [[unroll]] for (int j = 0; j < SL; ++j) acc[j] = V(0);
    uint wbase = gl_WorkGroupID.x * (KS / 2) * (8 * SL);
    const uint mm = min(m, p.M - 1);
    for (uint s = 0; s < KS; s += 2) {
        V w = lane < 8 * SL ? V(W[wbase + lane]) : V(0);
        wbase += 8 * SL;
        V a0 = LOADA(s * p.M + mm);
        V a1 = LOADA((s + 1) * p.M + mm);
        // weight index for (input slice h in {0,1}, output slice j, channel c): (h * SL + j) * 4 + c
        // (subgroupBroadcast needs a constant lane: spelled out per j.)
#define SJ(h, a, j)                                                     \
        acc[j] += subgroupBroadcast(w, (h * SL + j) * 4 + 0) * a.x;    \
        acc[j] += subgroupBroadcast(w, (h * SL + j) * 4 + 1) * a.y;    \
        acc[j] += subgroupBroadcast(w, (h * SL + j) * 4 + 2) * a.z;    \
        acc[j] += subgroupBroadcast(w, (h * SL + j) * 4 + 3) * a.w;
#if SL == 1
#define STEP(h, a) SJ(h, a, 0)
#elif SL == 2
#define STEP(h, a) SJ(h, a, 0) SJ(h, a, 1)
#else
#define STEP(h, a) SJ(h, a, 0) SJ(h, a, 1) SJ(h, a, 2) SJ(h, a, 3)
#endif
        STEP(0, a0)
        STEP(1, a1)
    }
    if (m < p.M)
        [[unroll]] for (int j = 0; j < SL; ++j) C[m * (p.N / 4) + ds + j] = vec4(acc[j]);
}
