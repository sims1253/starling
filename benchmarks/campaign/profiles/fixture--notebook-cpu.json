{
  "artifacts": [],
  "backend": "cpu",
  "build": {
    "artifacts_out": [
      "build-campaign/starling-serve-contract-fixture"
    ],
    "shell": "cmake -B build-campaign -DSTARLING_SERVE=ON -DSTARLING_GGML_TESTS=ON -DBUILD_SHARED_LIBS=OFF -DGGML_NATIVE=OFF -DGGML_LLAMAFILE=OFF && cmake --build build-campaign --parallel ${STARLING_CAMPAIGN_BUILD_JOBS:-4} --target starling-serve-contract-fixture"
  },
  "defaults": {
    "allowed_paths": [
      "cpp/serve/**"
    ],
    "budgets": {
      "agent_timeout_s": 1800.0,
      "attempt_wall_clock_s": 3600.0,
      "campaign_wall_clock_s": 14400.0,
      "cooldown_max_s": 600.0,
      "gate_timeout_s": 1800.0,
      "max_attempts": 4,
      "token_budget": null
    }
  },
  "device": "notebook",
  "engine": "auto",
  "gates": [
    {
      "argv": [
        "{python}",
        "{trusted}/benchmarks/campaign/gates/serve_contract_smoke.py",
        "--binary",
        "{candidate}/starling-serve-contract-fixture",
        "--baseline-binary",
        "{baseline}/starling-serve-contract-fixture",
        "--model",
        "parakeet"
      ],
      "name": "serve-contract",
      "required": true,
      "rules": [
        {
          "metric": "contract_ok",
          "op": "==",
          "value": 1
        },
        {
          "metric": "transcripts_match",
          "op": "==",
          "value": 1
        }
      ],
      "stage": "correctness",
      "timeout_s": 600.0
    },
    {
      "argv": [
        "{python}",
        "{trusted}/benchmarks/campaign/gates/experiments_ab.py",
        "--base-bin",
        "{best}/starling-serve-contract-fixture",
        "--cand-bin",
        "{candidate}/starling-serve-contract-fixture",
        "--run-dir",
        "{attempt_dir}/experiment",
        "--model",
        "parakeet"
      ],
      "name": "perf",
      "objective": true,
      "required": true,
      "rules": [
        {
          "metric": "verdict",
          "op": "==",
          "value": "pass"
        }
      ],
      "stage": "perf",
      "timeout_s": 1800.0
    }
  ],
  "heldout": {
    "description": "FLEURS held-out slice (default corpus + languages beyond the 100-clip English smoke set); used ONLY by finalize, never per attempt",
    "env": "STARLING_HELDOUT_DIR",
    "sha256": null
  },
  "id": "fixture--notebook-cpu",
  "model": {
    "hf_id": null,
    "name": "starling-serve contract fixture"
  },
  "objectives": [
    {
      "direction": "higher",
      "gate": "perf",
      "metric": "verdict",
      "min_improvement": 0.0,
      "name": "end-to-end latency"
    },
    {
      "direction": "higher",
      "gate": "serve-contract",
      "metric": "contract_ok",
      "min_improvement": 0.0,
      "name": "serve contract"
    }
  ],
  "quality_policy": {
    "notes": "fixture engine: exact contract by construction",
    "policy": "exact_numerical_contract"
  },
  "readiness_notes": "the real-repo CPU pilot: builds the contract fixture (no models, no GPU) and runs the sealed experiment comparator as the perf gate",
  "schema": "starling-campaign-profile/1",
  "slug": null,
  "status": "ready",
  "thresholds": {
    "max_temp_c": 85.0,
    "min_mem_available_mb": 2048.0
  },
  "tracking_issue": "#176",
  "workloads": [
    {
      "description": "0.5 s generated 16 kHz clip; the fixture engine returns a fixed transcript",
      "id": "generated-silence",
      "status": "available"
    }
  ]
}
