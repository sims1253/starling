{
  "artifacts": [
    {
      "name": "gguf",
      "path": "${STARLING_MODELS_DIR}/ark-asr-3b-q4-fullimx.gguf",
      "sha256": null
    },
    {
      "name": "fixture-short",
      "path": "${STARLING_FIXTURES_DIR}/short.wav",
      "sha256": null
    },
    {
      "name": "fixture-medium",
      "path": "${STARLING_FIXTURES_DIR}/medium.wav",
      "sha256": null
    },
    {
      "name": "fixture-long",
      "path": "${STARLING_FIXTURES_DIR}/long.wav",
      "sha256": null
    }
  ],
  "backend": "cpu",
  "build": {
    "artifacts_out": [
      "build-campaign/starling-bench"
    ],
    "shell": "NDK=$(ls -d \"${ANDROID_NDK_HOME:-${ANDROID_HOME:-/opt/android-sdk}/ndk}\"/* 2>/dev/null | sort -V | tail -1); [ -n \"$NDK\" ] || { echo 'Android NDK not found (set ANDROID_NDK_HOME or ANDROID_HOME)' >&2; exit 1; }; cmake -S . -B build-campaign -G Ninja -DCMAKE_TOOLCHAIN_FILE=\"$NDK/build/cmake/android.toolchain.cmake\" -DANDROID_ABI=arm64-v8a -DANDROID_PLATFORM=android-30 -DCMAKE_BUILD_TYPE=Release -DGGML_NATIVE=OFF -DGGML_LLAMAFILE=OFF -DGGML_OPENMP=OFF -DGGML_CPU_ARM_ARCH=armv8.2-a+dotprod+fp16+i8mm -DSTARLING_GGML_TESTS=OFF -DSTARLING_QUANTIZE=OFF -DBUILD_SHARED_LIBS=OFF && cmake --build build-campaign --parallel ${STARLING_CAMPAIGN_BUILD_JOBS:-4} --target starling-bench"
  },
  "defaults": {
    "allowed_paths": [
      "cpp/ark/**",
      "cpp/lib/**"
    ],
    "budgets": {
      "agent_timeout_s": 1800.0,
      "attempt_wall_clock_s": 3600.0,
      "campaign_wall_clock_s": 28800.0,
      "cooldown_max_s": 1200.0,
      "gate_timeout_s": 1800.0,
      "max_attempts": 6,
      "token_budget": null
    }
  },
  "device": "pixel",
  "device_expect": "Pixel 10 Pro",
  "engine": "ggml",
  "gates": [
    {
      "argv": [
        "bash",
        "{trusted}/benchmarks/campaign/gates/phone_bench_ab.sh",
        "--base-bin",
        "{best}/build-campaign/starling-bench",
        "--cand-bin",
        "{candidate}/build-campaign/starling-bench",
        "--model",
        "ark",
        "--gguf",
        "${STARLING_MODELS_DIR}/ark-asr-3b-q4-fullimx.gguf",
        "--wav",
        "${STARLING_FIXTURES_DIR}/medium.wav",
        "--engine",
        "ggml"
      ],
      "name": "phone-ab",
      "objective": true,
      "remote_cleanup": {
        "argv": [
          "adb",
          "shell",
          "for p in $(pidof starling-bench starling-bench-base starling-bench-cand); do kill -9 $p; done"
        ],
        "timeout_s": 30
      },
      "required": true,
      "rules": [
        {
          "metric": "transcripts_match",
          "op": "==",
          "value": 1
        },
        {
          "metric": "total_ms_delta_pct",
          "op": "<=",
          "value": -5.0
        }
      ],
      "stage": "perf",
      "timeout_s": 1800.0
    }
  ],
  "heldout": {
    "description": "FLEURS held-out slice (default corpus + languages beyond the 100-clip English smoke set); used ONLY by finalize, never per attempt",
    "env": "STARLING_HELDOUT_DIR",
    "sha256": null
  },
  "id": "ark--pixel",
  "model": {
    "hf_id": "AutoArk-AI/ARK-ASR-3B",
    "name": "ARK-ASR-3B"
  },
  "objectives": [
    {
      "direction": "lower",
      "gate": "phone-ab",
      "metric": "total_ms_delta_pct",
      "min_improvement": 5.0,
      "name": "latency"
    },
    {
      "direction": "higher",
      "gate": "phone-ab",
      "metric": "transcripts_match",
      "min_improvement": 0.0,
      "name": "quality"
    },
    {
      "direction": "lower",
      "gate": "phone-ab",
      "metric": "peak_rss_kb",
      "min_improvement": 0.0,
      "name": "peak memory"
    }
  ],
  "quality_policy": {
    "notes": "same-model kernel changes: transcripts must match the baseline exactly. Quant-change campaigns switch to quant_wer_gate: +0.2 absolute WER points per language unless stricter, and no promotion from the 100-clip English smoke set alone.",
    "policy": "exact_numerical_contract"
  },
  "readiness_notes": "ggml engine on the phone CPU",
  "schema": "starling-campaign-profile/1",
  "slug": "ark",
  "status": "ready",
  "thresholds": {
    "max_temp_c": 43.0,
    "min_battery_pct": 40.0,
    "min_mem_available_mb": 1500.0
  },
  "tracking_issue": "#355",
  "workloads": [
    {
      "description": "tests/fixtures short/medium/long clips through the bench gate",
      "id": "clips-short-medium-long",
      "status": "available"
    },
    {
      "description": "warm dictation session",
      "id": "warm-dictation",
      "owner_issue": "#226",
      "status": "unavailable"
    },
    {
      "description": "5-10 minute paced sessions",
      "id": "session-5-10min",
      "owner_issue": "#226",
      "status": "unavailable"
    },
    {
      "description": "model preload before speech starts",
      "id": "preload-before-speech",
      "owner_issue": "#229",
      "status": "unavailable"
    },
    {
      "description": "speech arriving while the model loads",
      "id": "speech-during-load",
      "owner_issue": "#229",
      "status": "unavailable"
    },
    {
      "description": "activation-to-capture latency",
      "id": "activation-to-capture",
      "owner_issue": "#310",
      "status": "unavailable"
    },
    {
      "description": "first partial transcript delay",
      "id": "first-partial",
      "owner_issue": "#310",
      "status": "unavailable"
    },
    {
      "description": "catch-up of accumulated audio backlog",
      "id": "catch-up-backlog",
      "owner_issue": "#310",
      "status": "unavailable"
    },
    {
      "description": "stop-to-final latency; sustained backlog must not drop audio",
      "id": "stop-to-final",
      "owner_issue": "#310",
      "status": "unavailable"
    }
  ]
}
