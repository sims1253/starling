{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:starling:contracts:personalization:v1",
  "$comment": [
    "Starling personalization without training, v1. Definitions only: each",
    "payload validates against its $defs entry. correctionRecord is the subset",
    "of a store_v2 correction_records row this contract reads; other row",
    "columns (processed_text, provider provenance, ...) are allowed."
  ],
  "$defs": {
    "correctionRecord": {
      "type": "object",
      "required": [
        "id",
        "capture_id",
        "request_id",
        "raw_text",
        "final_text",
        "decision",
        "decision_utc"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "capture_id": {
          "type": "string"
        },
        "request_id": {
          "type": "string"
        },
        "raw_text": {
          "type": "string"
        },
        "final_text": {
          "type": [
            "string",
            "null"
          ]
        },
        "decision": {
          "enum": [
            "accepted",
            "rejected",
            "reverted",
            "edited"
          ]
        },
        "decision_utc": {
          "type": "string"
        },
        "mode_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "secure_field": {
          "type": "boolean"
        }
      }
    },
    "suggestion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target_type",
        "source_phrase",
        "target_phrase",
        "frequency",
        "consistency",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "target_type": {
          "enum": [
            "vocabulary",
            "replacement"
          ]
        },
        "source_phrase": {
          "type": "string",
          "minLength": 1
        },
        "target_phrase": {
          "type": "string",
          "minLength": 1
        },
        "frequency": {
          "type": "integer",
          "minimum": 1
        },
        "consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "status": {
          "enum": [
            "suggested",
            "accepted",
            "ignored"
          ]
        },
        "conflict": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_seen_utc": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "retrievalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode_id"
      ],
      "properties": {
        "mode_id": {
          "type": "string"
        },
        "language": {
          "type": [
            "string",
            "null"
          ]
        },
        "project_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "max_examples": {
          "type": "integer",
          "minimum": 1
        },
        "max_characters": {
          "type": "integer",
          "minimum": 1
        },
        "personalization_enabled": {
          "type": "boolean"
        }
      }
    },
    "retrievalResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "examples_used",
        "character_count",
        "formatted_context"
      ],
      "properties": {
        "examples_used": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "character_count": {
          "type": "integer",
          "minimum": 0
        },
        "formatted_context": {
          "type": "string"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "min_frequency",
        "min_consistency",
        "max_retrieval_examples",
        "max_retrieval_characters",
        "personalization_enabled"
      ],
      "properties": {
        "min_frequency": {
          "type": "integer",
          "minimum": 1
        },
        "min_consistency": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "max_retrieval_examples": {
          "type": "integer",
          "minimum": 1
        },
        "max_retrieval_characters": {
          "type": "integer",
          "minimum": 1
        },
        "personalization_enabled": {
          "type": "boolean"
        }
      }
    }
  }
}
