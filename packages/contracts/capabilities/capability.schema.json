{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:starling:contracts:capability:v1",
  "$comment": [
    "Versioned server-capability descriptor for starling-serve (issue draft E10).",
    "Every field describes what the CURRENT native server implements; evidence",
    "file:line references live in README.md. Nothing aspirational: an",
    "unimplemented capability is absent or explicitly false, and a configurable",
    "value is modelled as a {value, cli_flag} setting so clients can tell a",
    "fixed limit from a deployment-tunable default.",
    "The descriptor is a superset of the partial capability shape already",
    "served by GET /v1/starling/capabilities; the field mapping is pinned by",
    "tests/test_capabilities_conformance.py."
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "product",
    "endpoints",
    "audio",
    "models",
    "responses",
    "streaming",
    "limits",
    "request_ids",
    "error_contract",
    "features"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "product": { "const": "starling-serve" },
    "endpoints": { "$ref": "#/$defs/endpoints" },
    "audio": { "$ref": "#/$defs/audio" },
    "models": { "$ref": "#/$defs/models" },
    "responses": { "$ref": "#/$defs/responses" },
    "streaming": { "$ref": "#/$defs/streaming" },
    "limits": { "$ref": "#/$defs/limits" },
    "request_ids": { "$ref": "#/$defs/requestIds" },
    "error_contract": { "$ref": "#/$defs/errorContract" },
    "features": { "$ref": "#/$defs/features" }
  },
  "$defs": {
    "endpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": ["method", "path", "protocol"],
      "properties": {
        "method": { "enum": ["GET", "POST", "DELETE"] },
        "path": {
          "type": "string",
          "pattern": "^/",
          "description": "Literal route; {name} marks a path parameter."
        },
        "protocol": {
          "enum": [
            "starling-legacy",
            "starling-extension",
            "starling-streaming",
            "openai-subset"
          ]
        },
        "upgrade": { "enum": ["websocket"] },
        "alias_of": { "type": "string", "pattern": "^/" },
        "requires": {
          "type": "string",
          "description": "Condition under which the route serves this purpose."
        },
        "purpose": { "type": "string" }
      }
    },
    "numberSetting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "cli_flag"],
      "properties": {
        "value": { "type": "number", "minimum": 0 },
        "cli_flag": {
          "type": "string",
          "description": "CLI flag that overrides the default; '(fixed)' when the value is compile-time."
        },
        "zero_means": { "type": "string" }
      }
    },
    "endpoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_transcription",
        "text_normalization",
        "live_transcription",
        "control",
        "discovery"
      ],
      "properties": {
        "batch_transcription": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/endpoint" }
        },
        "text_normalization": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/endpoint" }
        },
        "live_transcription": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/endpoint" }
        },
        "control": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/endpoint" }
        },
        "discovery": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/endpoint" }
        }
      }
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sample_rates_hz",
        "resampling",
        "channel_handling",
        "max_upload_mb",
        "batch",
        "live"
      ],
      "properties": {
        "sample_rates_hz": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "resampling": {
          "type": "boolean",
          "description": "False: the native server rejects other rates instead of resampling."
        },
        "channel_handling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wav_max_channels", "wav_mixdown", "pcm16_channels"],
          "properties": {
            "wav_max_channels": { "type": "integer", "minimum": 1 },
            "wav_mixdown": { "const": "average_to_mono" },
            "pcm16_channels": { "const": 1 }
          }
        },
        "max_upload_mb": {
          "type": "integer",
          "minimum": 1,
          "description": "Fixed compile-time limit; the native CLI has no override flag."
        },
        "batch": {
          "type": "object",
          "additionalProperties": false,
          "required": ["starling_legacy", "openai_subset"],
          "properties": {
            "starling_legacy": {
              "type": "object",
              "additionalProperties": false,
              "required": ["containers", "wav_magic"],
              "properties": {
                "containers": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "enum": ["wav", "pcm16le"] }
                },
                "wav_magic": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "enum": ["RIFF", "RF64", "RIFX"] }
                }
              }
            },
            "openai_subset": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "containers",
                "wav_magic",
                "multipart_file_part_name",
                "multipart_model_field_required"
              ],
              "properties": {
                "containers": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "const": "wav" }
                },
                "wav_magic": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "enum": ["RIFF", "RF64"] }
                },
                "multipart_file_part_name": { "const": "file" },
                "multipart_model_field_required": { "const": true }
              }
            }
          }
        },
        "live": {
          "type": "object",
          "additionalProperties": false,
          "required": ["containers", "whole_sample_frames_required"],
          "properties": {
            "containers": {
              "type": "array",
              "minItems": 1,
              "items": { "enum": ["wav", "pcm16le"] }
            },
            "whole_sample_frames_required": {
              "const": true,
              "description": "Odd-length raw PCM16 frames are rejected (split sample)."
            }
          }
        }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "listing_endpoint",
        "resident_limit",
        "served",
        "selection_semantics",
        "created_semantics"
      ],
      "properties": {
        "listing_endpoint": { "const": "/v1/models" },
        "resident_limit": {
          "const": 1,
          "description": "One model is resident per process; selecting another slug is not supported."
        },
        "served": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "object", "created", "owned_by"],
            "properties": {
              "id": { "type": "string", "minLength": 1 },
              "object": { "const": "model" },
              "created": { "const": 0 },
              "owned_by": { "const": "starling" }
            }
          }
        },
        "selection_semantics": {
          "const": "single-configured-model",
          "description": "The model field must name the configured slug; any other value returns 404."
        },
        "created_semantics": {
          "const": "not-tracked",
          "description": "created is always 0: the server does not track a model creation timestamp."
        }
      }
    },
    "responses": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openai_subset_formats",
        "openai_subset_plain_text_content_type",
        "starling_legacy_shape",
        "streaming_final_shape"
      ],
      "properties": {
        "openai_subset_formats": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["json", "text"] }
        },
        "openai_subset_plain_text_content_type": {
          "const": "text/plain; charset=utf-8"
        },
        "starling_legacy_shape": {
          "const": "{text, segments: [{text, start_s, end_s}], duration_s, request_id}"
        },
        "streaming_final_shape": {
          "const": "{type: final, text, segments: [{text, start_s, end_s}], duration_s}"
        }
      }
    },
    "streaming": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transport",
        "path",
        "protocol",
        "openai_realtime_compatible",
        "audio_frames",
        "server_messages",
        "client_controls",
        "chunking",
        "finalization",
        "live_buffer_cap",
        "take_invalidation",
        "heartbeat"
      ],
      "properties": {
        "transport": { "const": "websocket" },
        "path": { "const": "/stream" },
        "protocol": { "const": "starling-streaming" },
        "openai_realtime_compatible": {
          "const": false,
          "description": "WS /stream is Starling's own protocol, not OpenAI Realtime."
        },
        "audio_frames": {
          "const": "binary WAV or raw little-endian PCM16 mono at the declared sample rate"
        },
        "server_messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["partial", "final", "error", "pong", "reset_ack"]
          }
        },
        "client_controls": {
          "type": "array",
          "minItems": 1,
          "items": { "enum": ["commit", "reset", "ping"] }
        },
        "chunking": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "window_seconds",
            "overlap_seconds",
            "min_seconds_before_first_partial",
            "min_seconds_between_partials",
            "overlap_dedup"
          ],
          "properties": {
            "window_seconds": { "$ref": "#/$defs/numberSetting" },
            "overlap_seconds": { "$ref": "#/$defs/numberSetting" },
            "min_seconds_before_first_partial": { "$ref": "#/$defs/numberSetting" },
            "min_seconds_between_partials": { "$ref": "#/$defs/numberSetting" },
            "overlap_dedup": {
              "const": "word-match-at-boundary",
              "description": "Word matching reduces overlap duplication but cannot guarantee agreement across windows."
            }
          }
        },
        "finalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["commit", "busy", "invalidated_take", "reset"],
          "properties": {
            "commit": {
              "const": "commit finalizes all buffered audio and answers one final message"
            },
            "busy": {
              "const": "busy commit answers error 'server busy' and retains the audio for retry"
            },
            "invalidated_take": {
              "const": "commit on an invalidated take is refused with an error instead of a final"
            },
            "reset": {
              "const": "reset discards buffered audio, answers reset_ack, and re-enables audio acceptance"
            }
          }
        },
        "live_buffer_cap": {
          "type": "object",
          "additionalProperties": false,
          "required": ["default_seconds", "behavior"],
          "properties": {
            "default_seconds": { "$ref": "#/$defs/numberSetting" },
            "behavior": {
              "const": "one error frame per rejection, further audio ignored until reset; bounds the live (un-finalized) buffer only"
            }
          }
        },
        "take_invalidation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["reasons", "recovery"],
          "properties": {
            "reasons": {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": ["malformed_wav", "sample_rate_mismatch", "odd_pcm_length"]
              }
            },
            "recovery": {
              "const": "client resets and falls back to its authoritative local recording"
            }
          }
        },
        "heartbeat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ping_interval_seconds", "max_missed_pongs"],
          "properties": {
            "ping_interval_seconds": { "const": 30 },
            "max_missed_pongs": { "const": 3 }
          }
        }
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_queue_waiters",
        "request_timeout_seconds",
        "idle_shutdown_seconds",
        "serial_inference"
      ],
      "properties": {
        "max_queue_waiters": {
          "type": "integer",
          "minimum": 1,
          "description": "Beyond this many concurrent waiters the server answers 503 busy (compile-time)."
        },
        "request_timeout_seconds": { "$ref": "#/$defs/numberSetting" },
        "idle_shutdown_seconds": { "$ref": "#/$defs/numberSetting" },
        "serial_inference": {
          "const": true,
          "description": "Requests queue in arrival order; one inference is in flight at a time."
        }
      }
    },
    "requestIds": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "fallback_header",
        "generated_when_absent",
        "reserved_prefix",
        "echo_legacy",
        "echo_openai_subset",
        "cancellation"
      ],
      "properties": {
        "header": { "const": "X-Request-Id" },
        "fallback_header": { "const": "X-Correlation-Id" },
        "generated_when_absent": { "const": true },
        "reserved_prefix": {
          "const": "#",
          "description": "Client-supplied ids starting with # are rejected with 400."
        },
        "echo_legacy": {
          "const": "request_id field in the JSON body"
        },
        "echo_openai_subset": {
          "const": "X-Request-Id response header"
        },
        "cancellation": {
          "const": "DELETE /inference/{request_id}"
        }
      }
    },
    "errorContract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bodies",
        "non_json_bodies_possible",
        "clients_must_check_status_first",
        "status_codes"
      ],
      "properties": {
        "bodies": {
          "type": "object",
          "additionalProperties": false,
          "required": ["openai_subset", "starling_legacy"],
          "properties": {
            "openai_subset": {
              "const": "{error: {message, type, param, code}}"
            },
            "starling_legacy": {
              "const": "{error: string, text: \"\", request_id?}"
            }
          }
        },
        "non_json_bodies_possible": {
          "const": true,
          "description": "Malformed/oversized requests rejected by the HTTP parser can get the parser's own non-JSON error."
        },
        "clients_must_check_status_first": { "const": true },
        "status_codes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code", "when"],
            "properties": {
              "code": {
                "enum": [400, 404, 409, 413, 499, 500, 503, 504]
              },
              "when": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "features": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "audio_transcription",
        "text_normalization",
        "prompt",
        "language_selection",
        "word_timestamps",
        "segment_timestamps",
        "verbose_json",
        "subtitle_formats",
        "diarization",
        "sampling_controls",
        "server_sent_transcription_events",
        "openai_realtime",
        "resampling",
        "authentication"
      ],
      "properties": {
        "audio_transcription": {
          "type": "boolean",
          "description": "False only when the resident model is a text model (s1)."
        },
        "text_normalization": {
          "type": "boolean",
          "description": "True only when the resident model is a text model (s1)."
        },
        "prompt": { "const": false },
        "language_selection": { "const": false },
        "word_timestamps": { "const": false },
        "segment_timestamps": {
          "const": true,
          "description": "Legacy and streaming-final responses carry one segment with start_s/end_s."
        },
        "verbose_json": { "const": false },
        "subtitle_formats": {
          "const": false,
          "description": "SRT/VTT are not implemented."
        },
        "diarization": { "const": false },
        "sampling_controls": {
          "const": false,
          "description": "temperature must be 0 or 0.0; no configurable sampling is exposed."
        },
        "server_sent_transcription_events": {
          "const": false,
          "description": "The OpenAI-compatible route has no streaming; stream=false only."
        },
        "openai_realtime": { "const": false },
        "resampling": {
          "const": false,
          "description": "Non-16kHz WAV is rejected with 400 (the deprecated Python server resamples instead)."
        },
        "authentication": {
          "const": false,
          "description": "Loopback service; the API key is not checked."
        }
      }
    }
  }
}
