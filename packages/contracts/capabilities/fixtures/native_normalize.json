{
  "name": "Native text normalization (s1 text models)",
  "route": "/normalize",
  "protocol": "starling-extension",
  "sources": [
    "cpp/serve/main.cpp:826-922",
    "tests/test_native_serve.py:test_normalize_endpoints",
    "backends/native/tests/test_openai_api.py:NormalizeContract",
    "docs/native-serving.md#post-normalize-s1-only"
  ],
  "cases": [
    {
      "name": "valid body on the fixture engine echoes the transcript",
      "request": {
        "method": "POST",
        "path": "/normalize",
        "headers": {
          "Content-Type": "application/json"
        },
        "body_json": {
          "transcript": "hi 😀 𠮷 bye"
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/json",
        "body_json": {
          "text": "hi 😀 𠮷 bye",
          "request_id": "<generated>"
        }
      },
      "note": "The contract fixture engine double-echoes the decoded transcript (raw UTF-8 and \\u-escaped surrogate pairs decode identically), pinning \\u decoding byte-for-byte. A real s1 model returns normalized text; optional control fields are styling/structure/context."
    },
    {
      "name": "audio model has no text path",
      "request": {
        "method": "POST",
        "path": "/normalize",
        "headers": {
          "Content-Type": "application/json"
        },
        "body_json": {
          "transcript": "hi"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
          "error": "model has no text path (audio models use /v1/audio/transcriptions)"
        }
      },
      "note": "When the resident model is an audio model."
    },
    {
      "name": "missing or malformed transcript field",
      "request": {
        "method": "POST",
        "path": "/normalize",
        "headers": {
          "Content-Type": "application/json"
        },
        "body_json": {
          "styling": "casual"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
          "error": "missing or malformed 'transcript' field"
        }
      }
    },
    {
      "name": "empty body",
      "request": {
        "method": "POST",
        "path": "/normalize",
        "body_text": ""
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
          "error": "empty request body"
        }
      }
    },
    {
      "name": "malformed unicode escape",
      "request": {
        "method": "POST",
        "path": "/normalize",
        "headers": {
          "Content-Type": "application/json"
        },
        "body_text": "{\"transcript\": \"bad \\uZZZZ\"}"
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
          "error": "missing or malformed 'transcript' field"
        }
      },
      "note": "A malformed \\u escape fails field decoding; an unpaired surrogate half instead decodes to U+FFFD and the request succeeds."
    },
    {
      "name": "reserved request id prefix",
      "request": {
        "method": "POST",
        "path": "/normalize",
        "headers": {
          "Content-Type": "application/json",
          "X-Request-Id": "#123"
        },
        "body_json": {
          "transcript": "um hi"
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
          "error": "invalid request id"
        }
      }
    }
  ]
}
