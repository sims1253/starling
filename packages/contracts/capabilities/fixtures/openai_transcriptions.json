{
  "name": "OpenAI-compatible batch transcription subset",
  "route": "/v1/audio/transcriptions",
  "protocol": "openai-subset",
  "sources": [
    "cpp/serve/main.cpp:757-824 (route handler and error envelope)",
    "backends/native/tests/test_openai_api.py (deterministic fixture-engine bodies)",
    "tests/test_native_serve.py (transport contract on the live server)",
    "docs/api.md#supported-subset",
    "packages/contracts/openapi.json (/v1/audio/transcriptions)"
  ],
  "cases": [
    {
      "name": "json response preserves raw text",
      "request": {
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "multipart_fields": [{ "name": "model", "value": "parakeet" }],
        "multipart_file": {
          "name": "file",
          "filename": "audio.wav",
          "audio": { "format": "wav", "sample_rate_hz": 16000, "channels": 1, "duration_s": 0.01 }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/json",
        "headers": { "X-Request-Id": "<generated or echoed>" },
        "body_json": {
          "text": "5. Keep auth.\n6. I'd prefer to never merge this.\n7. I like orange, err, yellow.\n8. A. Agreed. café 🎙"
        }
      },
      "note": "Fixture-engine transcript (test_openai_api.py:RAW); a real model returns its own raw recognition text with no cleanup."
    },
    {
      "name": "plain text response format",
      "request": {
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "multipart_fields": [
          { "name": "model", "value": "parakeet" },
          { "name": "response_format", "value": "text" }
        ],
        "multipart_file": {
          "name": "file",
          "filename": "audio.wav",
          "audio": { "format": "wav", "sample_rate_hz": 16000, "channels": 1, "duration_s": 0.01 }
        }
      },
      "response": {
        "status": 200,
        "content_type": "text/plain; charset=utf-8",
        "body_text": "5. Keep auth.\n6. I'd prefer to never merge this.\n7. I like orange, err, yellow.\n8. A. Agreed. café 🎙"
      }
    },
    {
      "name": "compatibility defaults stream=false temperature=0 are accepted",
      "request": {
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "multipart_fields": [
          { "name": "model", "value": "parakeet" },
          { "name": "stream", "value": "false" },
          { "name": "temperature", "value": "0" }
        ],
        "multipart_file": {
          "name": "file",
          "audio": { "format": "wav", "sample_rate_hz": 16000, "channels": 1, "duration_s": 0.01 }
        }
      },
      "response": {
        "status": 200,
        "content_type": "application/json",
        "body_json": {
          "text": "5. Keep auth.\n6. I'd prefer to never merge this.\n7. I like orange, err, yellow.\n8. A. Agreed. café 🎙"
        }
      },
      "note": "temperature=0.0 is equally accepted; any other value is an unsupported option."
    },
    {
      "name": "missing model field",
      "request": {
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "multipart_file": {
          "name": "file",
          "audio": { "format": "wav", "sample_rate_hz": 16000, "channels": 1 }
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
          "error": {
            "message": "Exactly one model field is required; use GET /v1/models",
            "type": "invalid_request_error",
            "param": "model",
            "code": null
          }
        }
      }
    },
    {
      "name": "model not served by this process",
      "request": {
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "multipart_fields": [{ "name": "model", "value": "other" }],
        "multipart_file": {
          "name": "file",
          "audio": { "format": "wav", "sample_rate_hz": 16000, "channels": 1 }
        }
      },
      "response": {
        "status": 404,
        "content_type": "application/json",
        "body_json": {
          "error": {
            "message": "Requested model is not served by this process; use GET /v1/models",
            "type": "invalid_request_error",
            "param": "model",
            "code": null
          }
        }
      },
      "note": "One-model server: only the configured slug is served; selection cannot load another model."
    },
    {
      "name": "text model rejects audio",
      "request": {
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "multipart_fields": [{ "name": "model", "value": "s1" }],
        "multipart_file": {
          "name": "file",
          "audio": { "format": "wav", "sample_rate_hz": 16000, "channels": 1 }
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
          "error": {
            "message": "This model accepts text, not audio",
            "type": "invalid_request_error",
            "param": "model",
            "code": null
          }
        }
      },
      "note": "When the resident model is s1 (text path)."
    },
