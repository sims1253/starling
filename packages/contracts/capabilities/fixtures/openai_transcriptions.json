    {
      "name": "compressed audio is not reinterpreted as PCM",
      "request": {
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "multipart_fields": [{ "name": "model", "value": "parakeet" }],
        "multipart_file": {
          "name": "file",
          "filename": "audio.mp3",
          "audio": { "format": "mp3", "note": "b\"ID3 unsupported mp3 data\"" }
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
          "error": {
            "message": "This backend accepts 16 kHz WAV files; convert compressed audio before upload",
            "type": "invalid_request_error",
            "param": "file",
            "code": null
          }
        }
      }
    },
    {
      "name": "wrong sample rate gets the standard error envelope",
      "request": {
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "multipart_fields": [{ "name": "model", "value": "parakeet" }],
        "multipart_file": {
          "name": "file",
          "audio": { "format": "wav", "sample_rate_hz": 48000, "channels": 1 }
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
          "error": {
            "message": "sample rate mismatch: expected 16000 got 48000",
            "type": "invalid_request_error",
            "param": null,
            "code": null
          }
        }
      },
      "note": "The legacy handler's flat error string is re-wrapped in the OpenAI envelope; the native server has no resampler."
