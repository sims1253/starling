    {
      "name": "non-multipart body",
      "request": {
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "headers": { "Content-Type": "application/json" },
        "body_json": { "model": "parakeet" }
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
