      "request": {
        "method": "POST",
        "path": "/v1/audio/transcriptions",
        "multipart_fields": [{ "name": "model", "value": "parakeet" }],
        "multipart_file": {
          "name": "audio",
          "filename": "audio.wav",
          "audio": { "format": "wav", "sample_rate_hz": 16000, "channels": 1 }
        }
      },
      "response": {
        "status": 400,
        "content_type": "application/json",
        "body_json": {
