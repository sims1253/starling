{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:starling:contracts:capability-fixture:v1",
  "$comment": [
    "Envelope for one conformance fixture file: request/response pairs for a",
    "single route of the native starling-serve (issue draft E10). Every case",
    "cites its evidence in `sources` (file:test or file:line in the repo);",
    "bodies are copied from documented behavior and existing tests, never",
    "invented. Audio payloads are described structurally (format, rate, size)",
    "not embedded, so the fixtures stay reviewable.",
    "WS cases use status 101 (the real HTTP upgrade status) plus ws_messages;",
    "a client disconnect case uses then_disconnect + after_disconnect."
  ],
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "route",
    "protocol",
    "sources",
    "cases"
  ],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1
    },
    "route": {
      "type": "string",
      "pattern": "^/"
    },
    "protocol": {
      "enum": [
        "openai-subset",
        "starling-extension",
        "starling-streaming"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/case"
      }
    }
  },
  "$defs": {
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "request",
        "response"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "request": {
          "$ref": "#/$defs/request"
        },
        "response": {
          "$ref": "#/$defs/response"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "audioSpec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "format"
      ],
      "properties": {
        "format": {
          "enum": [
            "wav",
            "pcm16le",
            "mp3",
            "other"
          ]
        },
        "sample_rate_hz": {
          "type": "integer",
          "minimum": 1
        },
        "channels": {
          "type": "integer",
          "minimum": 1
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "duration_s": {
          "type": "number",
          "minimum": 0
        },
        "note": {
          "type": "string"
        }
      }
    },
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "method"
      ],
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "DELETE",
            "WS"
          ]
        },
        "path": {
          "type": "string",
          "pattern": "^/"
        },
        "headers": {
          "type": "object"
        },
        "multipart_fields": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "value"
            ],
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1
              },
              "value": {
                "type": "string"
              }
            }
          }
        },
        "multipart_file": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "audio"
          ],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "filename": {
              "type": "string"
            },
            "audio": {
              "$ref": "#/$defs/audioSpec"
            }
          }
        },
        "body_json": {},
        "body_text": {
          "type": "string"
        },
        "body_audio": {
          "$ref": "#/$defs/audioSpec"
        },
        "body_bytes_hex": {
          "type": "string"
        },
        "ws_frames": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "text",
                  "binary"
                ]
              },
              "message_json": {},
              "audio": {
                "$ref": "#/$defs/audioSpec"
              },
              "bytes_hex": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          }
        },
        "then_disconnect": {
          "type": "boolean"
        },
        "note": {
          "type": "string"
        }
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "integer",
          "minimum": 100
        },
        "content_type": {
          "type": "string"
        },
        "headers": {
          "type": "object"
        },
        "body_json": {},
        "body_text": {
          "type": "string"
        },
        "body_non_json": {
          "type": "boolean"
        },
        "ws_messages": {
          "type": "array"
        },
        "after_disconnect": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
