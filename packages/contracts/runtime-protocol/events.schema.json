{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:starling:contracts:runtime-protocol:events:v1",
  "$comment": [
    "Starling runtime protocol events, v1 (E17 design note section 2).",
    "Exactly the v1 event set of the five machines plus the runtime-level",
    "runtime.nack. Every branch is a full envelope (envelope.schema.json)",
    "whose payload is discriminated by type. additionalProperties is false on",
    "every branch and every payload: an unknown event or payload field is a",
    "validation failure, never a silently ignored extra.",
    "runtime.nack is the reply to a message whose envelope version cannot be",
    "parsed (v1 knows reason \"unsupported_version\" only). It carries",
    "corr = the id of the rejected message; the payload is never applied."
  ],
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "capture.started" },
        "payload": { "$ref": "#/$defs/payloads/capture.started" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "capture.progress" },
        "payload": { "$ref": "#/$defs/payloads/capture.progress" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "capture.gap" },
        "payload": { "$ref": "#/$defs/payloads/capture.gap" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "capture.error" },
        "payload": { "$ref": "#/$defs/payloads/capture.error" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "capture.stopped" },
        "payload": { "$ref": "#/$defs/payloads/capture.stopped" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "jobs.queued" },
        "payload": { "$ref": "#/$defs/payloads/jobs.queued" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "jobs.rejected" },
        "payload": { "$ref": "#/$defs/payloads/jobs.rejected" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "jobs.progress" },
        "payload": { "$ref": "#/$defs/payloads/jobs.progress" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "jobs.completed" },
        "payload": { "$ref": "#/$defs/payloads/jobs.completed" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "jobs.failed" },
        "payload": { "$ref": "#/$defs/payloads/jobs.failed" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "context.targetSnapshot" },
        "payload": { "$ref": "#/$defs/payloads/context.targetSnapshot" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "mode.decision" },
        "payload": { "$ref": "#/$defs/payloads/mode.decision" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "mode.routeFrozen" },
        "payload": { "$ref": "#/$defs/payloads/mode.routeFrozen" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "docs.headUpdated" },
        "payload": { "$ref": "#/$defs/payloads/docs.headUpdated" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "docs.headConflict" },
        "payload": { "$ref": "#/$defs/payloads/docs.headConflict" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "docs.turnAppended" },
        "payload": { "$ref": "#/$defs/payloads/docs.turnAppended" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "delivery.prepared" },
        "payload": { "$ref": "#/$defs/payloads/delivery.prepared" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "delivery.submittedUnconfirmed" },
        "payload": { "$ref": "#/$defs/payloads/delivery.submittedUnconfirmed" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "delivery.confirmed" },
        "payload": { "$ref": "#/$defs/payloads/delivery.confirmed" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "delivery.failed" },
        "payload": { "$ref": "#/$defs/payloads/delivery.failed" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "delivery.conflict" },
        "payload": { "$ref": "#/$defs/payloads/delivery.conflict" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    },
    {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "v": { "$ref": "#/$defs/version" },
        "id": { "$ref": "#/$defs/msgId" },
        "ts": { "$ref": "#/$defs/timestamp" },
        "corr": { "$ref": "#/$defs/msgId" },
        "seq": { "$ref": "#/$defs/seq" },
        "type": { "const": "runtime.nack" },
        "payload": { "$ref": "#/$defs/payloads/runtime.nack" }
      },
      "required": ["v", "id", "ts", "type", "payload"]
    }
  ],
  "$defs": {
    "version": { "type": "integer", "const": 1 },
    "msgId": { "type": "string", "pattern": "^[A-Za-z0-9_.:-]{1,128}$" },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "seq": { "type": "integer", "minimum": 0 },
    "safeToken": { "type": "string", "pattern": "^[A-Za-z0-9_.:+-]{1,128}$" },
    "payloads": {
      "capture.started": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "device": { "type": "string", "minLength": 1 },
          "actualRate": { "type": "integer", "minimum": 1 },
          "channels": { "type": "integer", "minimum": 1 }
        },
        "required": ["device", "actualRate", "channels"]
      },
      "capture.progress": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ackSamples": { "type": "integer", "minimum": 0 },
          "clipRatio": { "type": "number", "minimum": 0 },
          "level": { "type": "number", "minimum": 0 }
        },
        "required": ["ackSamples", "clipRatio", "level"]
      },
      "capture.gap": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startSample": { "type": "integer", "minimum": 0 },
          "endSample": { "type": "integer", "minimum": 0 }
        },
        "required": ["startSample", "endSample"]
      },
      "capture.error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": { "$ref": "#/$defs/safeToken" },
          "fatal": { "type": "boolean" }
        },
        "required": ["code", "fatal"]
      },
      "capture.stopped": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "finalSampleIndex": { "type": "integer", "minimum": 0 },
          "acknowledgedSamples": { "type": "integer", "minimum": 0 },
          "gaps": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "startSample": { "type": "integer", "minimum": 0 },
                "endSample": { "type": "integer", "minimum": 0 }
              },
              "required": ["startSample", "endSample"]
            }
          },
          "journalId": { "$ref": "#/$defs/safeToken" },
          "sampleDurationMs": { "type": "number", "minimum": 0 },
          "wallClockMs": { "type": "number", "minimum": 0 }
        },
        "required": [
          "finalSampleIndex",
          "acknowledgedSamples",
          "gaps",
          "journalId",
          "sampleDurationMs",
          "wallClockMs"
        ]
      },
      "jobs.queued": {
        "type": "object",
        "additionalProperties": false
      },
      "jobs.rejected": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": {
            "enum": ["queue_full", "resource_limits", "duplicate_submission"]
          }
        },
        "required": ["reason"]
      },
      "jobs.progress": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "partial": { "type": "string" },
          "stabilityHint": { "$ref": "#/$defs/safeToken" }
        },
        "required": ["partial", "stabilityHint"]
      },
      "jobs.completed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "attemptId": { "$ref": "#/$defs/msgId" },
          "text": { "type": "string" },
          "backend": { "$ref": "#/$defs/safeToken" },
          "timing": { "type": "number", "minimum": 0 },
          "completionEvidence": { "$ref": "#/$defs/safeToken" }
        },
        "required": ["attemptId", "text", "backend", "timing", "completionEvidence"]
      },
      "jobs.failed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": { "$ref": "#/$defs/safeToken" },
          "retryable": { "type": "boolean" }
        },
        "required": ["reason", "retryable"]
      },
      "context.targetSnapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "descriptor": { "$ref": "#/$defs/safeToken" },
          "digest": { "$ref": "#/$defs/safeToken" },
          "capabilities": {
            "type": "array",
            "items": { "$ref": "#/$defs/safeToken" }
          },
          "selectionRange": { "$ref": "#/$defs/payloads/span" },
          "offsetEncoding": { "$ref": "#/$defs/safeToken" },
          "expiry": { "$ref": "#/$defs/timestamp" }
        },
        "required": [
          "descriptor",
          "digest",
          "capabilities",
          "selectionRange",
          "offsetEncoding",
          "expiry"
        ]
      },
      "mode.decision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "modeId": { "$ref": "#/$defs/safeToken" },
          "source": { "enum": ["manual", "phrase", "rule"] },
          "matchedPrefixSpan": {
            "anyOf": [
              { "$ref": "#/$defs/payloads/span" },
              { "type": "null" }
            ]
          },
          "explanation": { "type": "string" },
          "payloadView": { "$ref": "#/$defs/safeToken" }
        },
        "required": ["modeId", "source", "matchedPrefixSpan", "explanation", "payloadView"]
      },
      "mode.routeFrozen": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "route": { "$ref": "#/$defs/safeToken" },
          "decidedAt": { "$ref": "#/$defs/timestamp" }
        },
        "required": ["route", "decidedAt"]
      },
      "docs.headUpdated": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "docId": { "$ref": "#/$defs/safeToken" },
          "headRevision": { "type": "integer", "minimum": 0 }
        },
        "required": ["docId", "headRevision"]
      },
      "docs.headConflict": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expected": { "type": "integer", "minimum": 0 },
          "actual": { "type": "integer", "minimum": 0 },
          "candidatePreserved": { "type": "boolean" }
        },
        "required": ["expected", "actual", "candidatePreserved"]
      },
      "docs.turnAppended": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "turnSeq": { "type": "integer", "minimum": 0 }
        },
        "required": ["turnSeq"]
      },
      "delivery.prepared": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deliveryId": { "$ref": "#/$defs/msgId" },
          "compareToken": { "$ref": "#/$defs/safeToken" }
        },
        "required": ["deliveryId", "compareToken"]
      },
      "delivery.submittedUnconfirmed": {
        "type": "object",
        "additionalProperties": false
      },
      "delivery.confirmed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "evidenceLevel": { "$ref": "#/$defs/safeToken" }
        },
        "required": ["evidenceLevel"]
      },
      "delivery.failed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": { "$ref": "#/$defs/safeToken" },
          "fallbackSuggested": { "type": "boolean" }
        },
        "required": ["reason", "fallbackSuggested"]
      },
      "delivery.conflict": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "expectedTarget": { "$ref": "#/$defs/safeToken" },
          "actualTarget": { "$ref": "#/$defs/safeToken" }
        },
        "required": ["expectedTarget", "actualTarget"]
      },
      "runtime.nack": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "reason": { "enum": ["unsupported_version"] }
        },
        "required": ["reason"]
      },
      "span": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "startOffset": { "type": "integer", "minimum": 0 },
          "endOffset": { "type": "integer", "minimum": 0 }
        },
        "required": ["startOffset", "endOffset"]
      }
    }
  }
}
