  "$defs": {
    "version": {
      "type": "integer",
      "const": 1
    },
    "msgId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "safeToken": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:+-]{1,128}$"
    },
    "payloads": {
      "capture.start": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "policy": {
            "$ref": "#/$defs/safeToken"
          }
        },
        "required": [
          "policy"
        ]
      },
      "capture.stop": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "drain": {
            "type": "boolean"
          }
        }
      },
      "capture.abort": {
        "type": "object",
        "additionalProperties": false
      },
      "jobs.submit": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "captureRef": {
            "$ref": "#/$defs/msgId"
          },
          "route": {
            "$ref": "#/$defs/safeToken"
          },
          "budget": {
            "$ref": "#/$defs/safeToken"
          }
        },
        "required": [
          "captureRef",
          "route",
          "budget"
        ]
      },
      "jobs.cancel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "jobId": {
            "$ref": "#/$defs/msgId"
          }
        },
        "required": [
          "jobId"
        ]
      },
      "jobs.setLimits": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "maxQueued": {
            "type": "integer",
            "minimum": 0
          },
          "maxConcurrent": {
            "type": "integer",
            "minimum": 0
          },
          "perRoute": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "route": {
                  "$ref": "#/$defs/safeToken"
                },
                "maxConcurrent": {
                  "type": "integer",
                  "minimum": 0
                }
              },
              "required": [
                "route",
                "maxConcurrent"
              ]
            }
          }
        },
        "required": [
          "maxQueued",
          "maxConcurrent"
        ]
      },
      "context.snapshot": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source": {
            "$ref": "#/$defs/safeToken"
          }
        },
        "required": [
          "source"
        ]
      },
      "mode.set": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "mode": {
            "$ref": "#/$defs/safeToken"
          },
          "source": {
            "const": "manual"
          }
        },
        "required": [
          "mode",
          "source"
        ]
      },
      "context.expire": {
        "type": "object",
        "additionalProperties": false
      },
      "docs.updateHead": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "docId": {
            "$ref": "#/$defs/safeToken"
          },
          "expectedBase": {
            "type": "integer",
            "minimum": 0
          },
          "newRevision": {
            "$ref": "#/$defs/payloads/revision"
          }
        },
        "required": [
          "docId",
          "expectedBase",
          "newRevision"
        ]
      },
      "docs.appendTurn": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "docId": {
            "$ref": "#/$defs/safeToken"
          },
          "takeRef": {
            "$ref": "#/$defs/msgId"
          }
        },
        "required": [
          "docId",
          "takeRef"
        ]
      },
      "docs.get": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "docId": {
            "$ref": "#/$defs/safeToken"
          },
          "page": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "docId",
          "page"
        ]
      },
      "delivery.prepare": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revisionId": {
            "$ref": "#/$defs/msgId"
          },
          "targetRef": {
            "$ref": "#/$defs/safeToken"
          }
        },
        "required": [
          "revisionId",
          "targetRef"
        ]
      },
      "delivery.apply": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deliveryId": {
            "$ref": "#/$defs/msgId"
          }
        },
        "required": [
          "deliveryId"
        ]
      },
      "delivery.cancel": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deliveryId": {
            "$ref": "#/$defs/msgId"
          }
        }
      },
      "delivery.copyFallback": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "deliveryId": {
            "$ref": "#/$defs/msgId"
          }
        },
        "required": [
          "deliveryId"
        ]
      },
      "revision": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "revId": {
            "$ref": "#/$defs/msgId"
          },
          "baseRevision": {
            "type": "integer",
            "minimum": 0
          },
          "sourceAttemptIds": {
            "type": "array",
            "items": {
              "$ref": "#/$defs/msgId"
            }
          },
          "instructionTemplateId": {
            "$ref": "#/$defs/safeToken"
          },
          "text": {
            "type": "string"
          },
          "status": {
            "$ref": "#/$defs/safeToken"
          },
          "provenance": {
            "$ref": "#/$defs/safeToken"
          }
        },
        "required": [
          "revId",
          "baseRevision",
          "sourceAttemptIds",
          "instructionTemplateId",
          "text",
          "status",
          "provenance"
        ]
      },
      "jobs.transform": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "request"
        ],
        "properties": {
          "request": {
            "$ref": "#/$defs/transformRequest"
          }
        }
      }
    },
    "transformRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "request_id",
        "retry_of",
        "draft_id",
        "capture_id",
        "base_revision",
        "source_attempt_ids",
        "mode_id",
        "mode_version",
        "prompt_version",
        "kinds",
        "language",
        "input",
        "instruction",
        "style",
        "context",
        "provider",
        "local_only",
        "deadline_ms",
        "max_output_chars"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "properties": {
                  "kind": {
                    "const": "builtin"
                  }
                },
                "required": [
                  "kind"
                ]
              }
            },
            "required": [
              "provider"
            ]
          },
          "then": {
            "properties": {
              "kinds": {
                "maxItems": 0
              }
            }
          },
          "else": {
            "properties": {
              "kinds": {
                "minItems": 1
              }
            }
          }
        }
      ],
      "properties": {
        "schema_version": {
          "const": 1
        },
        "request_id": {
          "$ref": "#/$defs/token"
        },
        "retry_of": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/token"
            }
          ]
        },
        "draft_id": {
          "$ref": "#/$defs/token"
        },
        "capture_id": {
          "$ref": "#/$defs/token"
        },
        "base_revision": {
          "type": "integer",
          "minimum": 0
        },
        "source_attempt_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/token"
          }
        },
        "mode_id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+$",
          "minLength": 1
        },
        "mode_version": {
          "type": "integer",
          "minimum": 1
        },
        "prompt_version": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/token"
            }
          ]
        },
        "kinds": {
          "type": "array",
          "items": {
            "enum": [
              "clean",
              "format",
              "rewrite",
              "translate"
            ]
          },
          "uniqueItems": true
        },
        "language": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
            }
          ]
        },
        "input": {
          "type": "string"
        },
        "instruction": {
          "type": [
            "string",
            "null"
          ]
        },
        "style": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "formality",
                "structure",
                "context"
              ],
              "properties": {
                "formality": {
                  "enum": [
                    "casual",
                    "semi-casual",
                    "semi-formal",
                    "formal"
                  ]
                },
                "structure": {
                  "enum": [
                    "prose",
                    "lists"
                  ]
                },
                "context": {
                  "enum": [
                    "general",
                    "email"
                  ]
                }
              }
            }
          ]
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "personal_context": {
              "type": "string",
              "minLength": 1
            },
            "vocabulary": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "provider": {
          "$ref": "#/$defs/providerRef"
        },
        "local_only": {
          "type": "boolean"
        },
        "deadline_ms": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_chars": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,128}$"
    },
    "route": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.-]+$",
      "minLength": 1
    },
    "providerKind": {
      "enum": [
        "builtin",
        "s1",
        "openai_compatible",
        "anthropic",
        "gemini"
      ]
    },
    "providerRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "locality",
        "route",
        "model",
        "artifact_sha256"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/token"
        },
        "kind": {
          "$ref": "#/$defs/providerKind"
        },
        "locality": {
          "enum": [
            "local",
            "remote"
          ]
        },
        "route": {
          "$ref": "#/$defs/route"
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "artifact_sha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    }
  }
}
