<?xml version="1.0" encoding="utf-8"?>
<!-- The phone's one screen, in the order it is used: record, read what was
     recorded, then the model, history audio, and the keyboard. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/main_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_title"
            android:textAppearance="@style/TextAppearance.Starling.Wordmark" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/screen_subtitle"
            android:textAppearance="@style/TextAppearance.Starling.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/record_heading"
            android:textAppearance="@style/TextAppearance.Starling.Heading" />

        <TextView
            android:id="@+id/recording_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Starling.Body" />

        <!-- Live partial transcript while the recording is transcribed;
             hidden when recording is plain or the live session failed (the
             durable WAV then decides the final text). -->
        <TextView
            android:id="@+id/live_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="@style/TextAppearance.Starling.Transcript"
            android:visibility="gone" />

        <!-- The one primary action: gold, rose while it stops a take
             (MainActivity sets it activated while recording). -->
        <Button
            android:id="@+id/record_button"
            style="@style/Widget.Starling.Button.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:drawableStart="@drawable/ic_record_hex"
            android:drawablePadding="10dp"
            android:gravity="center"
            android:text="@string/start_recording" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/recordings_heading"
            android:textAppearance="@style/TextAppearance.Starling.Heading" />

        <LinearLayout
            android:id="@+id/recordings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/model_heading"
            android:textAppearance="@style/TextAppearance.Starling.Heading" />

        <TextView
            android:id="@+id/on_device_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="@style/TextAppearance.Starling.Meta" />

        <!-- Filled by MainActivity.renderInstalledModels; hidden when none is installed. -->
        <TextView
            android:id="@+id/installed_models_heading"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/installed_models_heading"
            android:textAppearance="@style/TextAppearance.Starling.Subheading"
            android:visibility="gone" />

        <TextView
            android:id="@+id/installed_models_help"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/installed_models_help"
            android:textAppearance="@style/TextAppearance.Starling.Meta"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/installed_models"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Where models are kept (MainActivity.renderModelStorage). -->
        <TextView
            android:id="@+id/model_storage_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAppearance="@style/TextAppearance.Starling.Meta" />

        <Button
            android:id="@+id/share_models_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/share_models"
            android:visibility="gone" />

        <!-- Label set by MainActivity.renderDownload (size, resume state). -->
        <Button
            android:id="@+id/download_model_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/download_model_short" />

        <!-- Every other catalog model (MainActivity.chooseDownload). -->
        <Button
            android:id="@+id/download_other_model_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/download_other_model" />

        <Button
            android:id="@+id/import_model_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/import_model" />

        <!-- History audio (#342): retention limits per class, all off by
             default, and what the last cleanup did. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/history_audio_heading"
            android:textAppearance="@style/TextAppearance.Starling.Heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/history_audio_intro"
            android:textAppearance="@style/TextAppearance.Starling.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@+id/retention_standard_age"
            android:text="@string/retention_age_label"
            android:textAppearance="@style/TextAppearance.Starling.Subheading" />

        <Spinner
            android:id="@+id/retention_standard_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/retention_age_choices" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:labelFor="@+id/retention_standard_size"
            android:text="@string/retention_size_label"
            android:textAppearance="@style/TextAppearance.Starling.Subheading" />

        <Spinner
            android:id="@+id/retention_standard_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/retention_size_choices" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/history_audio_archival_intro"
            android:textAppearance="@style/TextAppearance.Starling.Body" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:labelFor="@+id/retention_archival_age"
            android:text="@string/retention_archival_age_label"
            android:textAppearance="@style/TextAppearance.Starling.Subheading" />

        <Spinner
            android:id="@+id/retention_archival_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/retention_age_choices" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:labelFor="@+id/retention_archival_size"
            android:text="@string/retention_archival_size_label"
            android:textAppearance="@style/TextAppearance.Starling.Subheading" />

        <Spinner
            android:id="@+id/retention_archival_size"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:entries="@array/retention_size_choices" />

        <TextView
            android:id="@+id/retention_report"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.Starling.Meta"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:text="@string/keyboard_heading"
            android:textAppearance="@style/TextAppearance.Starling.Heading" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/keyboard_intro"
            android:textAppearance="@style/TextAppearance.Starling.Body" />

        <Button
            android:id="@+id/open_keyboard_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_keyboard_settings" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/voice_input_intro"
            android:textAppearance="@style/TextAppearance.Starling.Body" />

    </LinearLayout>
</ScrollView>
