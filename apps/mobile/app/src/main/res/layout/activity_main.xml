<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingTop="28dp"
        android:paddingEnd="24dp"
        android:paddingBottom="32dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/screen_title"
            android:textColor="@color/starling_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/screen_subtitle"
            android:textColor="@color/starling_muted"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/backend_heading"
            android:textColor="@color/starling_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/endpoint_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:autofillHints="none"
            android:hint="@string/backend_endpoint_hint"
            android:inputType="textUri"
            android:singleLine="true"
            android:textColor="@color/starling_ink"
            android:textColorHint="@color/starling_muted" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/backend_endpoint_help"
            android:textColor="@color/starling_muted"
            android:textSize="13sp" />

        <CheckBox
            android:id="@+id/allow_http_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/allow_http"
            android:textColor="@color/starling_ink" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="-4dp"
            android:text="@string/allow_http_help"
            android:textColor="@color/starling_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/save_endpoint_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/save_endpoint" />

        <TextView
            android:id="@+id/endpoint_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/starling_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/protocol_heading"
            android:textColor="@color/starling_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/protocol_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/protocol_starling"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protocol_starling" />

            <RadioButton
                android:id="@+id/protocol_openai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/protocol_openai" />
        </RadioGroup>

        <EditText
            android:id="@+id/model_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:autofillHints="none"
            android:hint="@string/model_hint"
            android:inputType="text"
            android:singleLine="true"
            android:textColor="@color/starling_ink"
            android:textColorHint="@color/starling_muted"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/protocol_help"
            android:textColor="@color/starling_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/engine_heading"
            android:textColor="@color/starling_ink"
            android:textSize="15sp"
            android:textStyle="bold" />

        <RadioGroup
            android:id="@+id/engine_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/engine_server"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/engine_server" />

            <RadioButton
                android:id="@+id/engine_on_device"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/engine_on_device" />
        </RadioGroup>

        <TextView
            android:id="@+id/on_device_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="4dp"
            android:textColor="@color/starling_muted"
            android:textSize="13sp" />

        <Button
            android:id="@+id/import_model_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/import_model" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="24dp"
            android:background="@color/starling_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/record_heading"
            android:textColor="@color/starling_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/recording_message"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/starling_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/record_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/start_recording" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/recordings_heading"
            android:textColor="@color/starling_ink"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/recordings_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="18dp"
            android:background="@color/starling_line" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="@string/keyboard_intro"
            android:textColor="@color/starling_muted"
            android:textSize="14sp" />

        <Button
            android:id="@+id/open_keyboard_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/open_keyboard_settings" />
    </LinearLayout>
</ScrollView>
