<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/keyboard_height"
    android:background="@color/starling_surface"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:id="@+id/keyboard_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/starling_muted"
        android:textSize="13sp" />

    <!-- Where the on-device model stands (loading, failed); hidden when
         it is ready or the server engine is selected. -->
    <TextView
        android:id="@+id/keyboard_model_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:accessibilityLiveRegion="polite"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@color/starling_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!-- The keyboard keeps a fixed height, so long transcripts scroll
         instead of pushing the buttons off the view. -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="6dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:scrollbars="none">

        <TextView
            android:id="@+id/keyboard_transcript"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/starling_ink"
            android:textIsSelectable="true"
            android:textSize="15sp"
            android:visibility="gone" />
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        style="?android:attr/buttonBarStyle"
        android:orientation="horizontal">

        <!-- Back to the typing keyboard the user came from; hidden when
             there is no other keyboard to switch to. -->
        <Button
            android:id="@+id/keyboard_switch_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            style="?android:attr/buttonBarButtonStyle"
            android:contentDescription="@string/keyboard_switch_description"
            android:minWidth="48dp"
            android:text="@string/keyboard_switch_label"
            android:visibility="gone" />

        <Button
            android:id="@+id/keyboard_record_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/keyboard_record" />

        <Button
            android:id="@+id/keyboard_insert_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/keyboard_insert"
            android:visibility="gone" />

        <!-- The take's field is gone; its text can only be copied. -->
        <Button
            android:id="@+id/keyboard_copy_button"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/keyboard_copy"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
