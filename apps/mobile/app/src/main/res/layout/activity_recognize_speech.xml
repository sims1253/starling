<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minWidth="280dp"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/recognize_prompt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/starling_ink"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/recognize_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:accessibilityLiveRegion="polite"
        android:textColor="@color/starling_muted"
        android:textSize="14sp" />

    <!-- Live partials can grow long: bounded to a few lines that scroll,
         kept at the newest words by RecognizeSpeechActivity. -->
    <TextView
        android:id="@+id/recognize_partial"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:maxLines="8"
        android:scrollbars="vertical"
        android:textColor="@color/starling_ink"
        android:textSize="16sp"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        style="?android:attr/buttonBarStyle"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/recognize_cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@android:string/cancel" />

        <Button
            android:id="@+id/recognize_done_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/recognize_done" />
    </LinearLayout>
</LinearLayout>
