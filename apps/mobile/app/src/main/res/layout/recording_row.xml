<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/recording_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/recording_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/starling_ink"
        android:textSize="15sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/recording_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/starling_muted"
        android:textSize="13sp" />

    <TextView
        android:id="@+id/recording_transcript"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/starling_ink"
        android:textIsSelectable="true"
        android:textSize="15sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="end"
        style="?android:attr/buttonBarStyle"
        android:orientation="horizontal">

        <Button
            android:id="@+id/retry_recording_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/retry_recording" />

        <Button
            android:id="@+id/delete_recording_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            style="?android:attr/buttonBarButtonStyle"
            android:text="@string/delete_recording" />
    </LinearLayout>
</LinearLayout>
