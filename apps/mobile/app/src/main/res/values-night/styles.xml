<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night parent of Theme.StarlingMobile. The dark framework Material
         parent switches widget defaults to dark mode; the palette itself is
         overridden in values-night/colors.xml, the shared items live in
         values/styles.xml. -->
    <style name="Base.Theme.StarlingMobile" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <!-- Dark parent for the RECOGNIZE_SPEECH popup; its items live in values/styles.xml. -->
    <style name="Base.Theme.StarlingMobile.Dialog" parent="android:style/Theme.Material.Dialog.NoActionBar" />
</resources>
