<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.StarlingMobile" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/starling_accent</item>
        <item name="android:windowLightStatusBar">true</item>
        <!-- Still honored on Android 14 and below, where edge-to-edge is not
             enforced; Android 15+ ignores these items under enforced
             edge-to-edge, where the MainActivity insets listener applies. -->
        <item name="android:statusBarColor">@color/starling_surface</item>
        <item name="android:navigationBarColor">@color/starling_surface</item>
        <item name="android:windowBackground">@color/starling_surface</item>
    </style>

    <!-- The RECOGNIZE_SPEECH popup floats over the calling app. -->
    <style name="Theme.StarlingMobile.Dialog" parent="android:style/Theme.Material.Light.Dialog.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:colorAccent">@color/starling_accent</item>
    </style>
</resources>
