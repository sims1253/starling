    <color name="starling_card">#F7F6FA</color>
    <color name="starling_line">#CAC7DA</color>
    <color name="starling_beak">#E3AC3B</color>
    <color name="starling_on_beak">#1E1C36</color>
    <color name="starling_rose">#AE2F50</color>
    <color name="starling_on_rose">#FFFFFF</color>
