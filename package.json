{
  "name": "starling-workspace",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": ">=24.13.1"
  },
  "scripts": {
    "build": "vp run -r build",
    "typecheck": "tsc -p tsconfig.tools.json && vp run -r typecheck",
    "test": "vp run -r test",
    "quants": "python -m quants.starling_quants",
    "serve:python": "uv run --extra server starling-python-serve",
    "build:native": "cmake --preset native-cpu && cmake --build --preset native-cpu",
    "check": "pnpm run fmt:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
    "test:quants": "python -m unittest discover -s quants/tests -v",
    "test:api": "python -m unittest discover -s backends/native/tests -v",
    "lint": "vp lint --deny-warnings packages/dictation packages/serve vite.config.ts",
    "lint:fix": "vp lint --fix packages/dictation packages/serve vite.config.ts",
    "fmt": "vp fmt packages/dictation packages/serve vite.config.ts",
    "fmt:check": "vp fmt --check packages/dictation packages/serve vite.config.ts"
  },
  "devDependencies": {
    "@oxlint/plugins": "1.83.0",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.1"
}
